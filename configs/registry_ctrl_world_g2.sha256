      "intent_contract": {
        "method_intent": "Finetune world-model rollouts using an action-sensitive inverse-dynamics or state-progress reward.",
        "target_behavior": "Route the frozen reward signal into the declared H3 optimization objective with explicit budget and provenance.",
        "forbidden_substitutions": ["Do not use generated-video aesthetics or uncalibrated VLM scores as task-success reward."],
