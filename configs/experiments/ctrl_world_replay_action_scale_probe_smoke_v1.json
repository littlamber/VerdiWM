{
  "schema_version": 1,
  "artifact_type": "verdiwm-auto-experiment-plan",
  "campaign_id": "ctrl-world-replay-action-scale-probe-smoke-v1",
  "trial_id": "ctrl-world-replay-action-scale-probe-smoke-v1",
  "objective": "Verify a source-isolated Ctrl-World action-conditioning probe produces receipt-bound per-interaction predictive metrics on the frozen replay checkpoint.",
  "hypothesis": "The zero-dose action-embedding hook leaves a frozen Ctrl-World replay runnable while the probe records exactly one trajectory's paired video, per-interaction L1, and hook invocation evidence.",
  "selection_reason": "A single zero-dose replay is the minimum real GPU check for the new target-local probe before comparing action-conditioning doses.",
  "falsification_criterion": "The smoke is void if the external runtime exits nonzero, GPU identity or activity is missing, the action probe result is malformed, the paired video is missing, or the zero-dose hook was not invoked.",
  "stage": "smoke",
  "command": [
    "/path/to/VerdiWM/.venv/bin/python3",
    "-m",
    "wmloop.execute.external_evaluator_workload",
    "--artifact",
    "external-output/result.json=action-probe-result.json",
    "--artifact",
    "external-output/rollout.mp4=rollout.mp4",
    "--metrics-artifact",
    "action-probe-result.json",
    "--metric-prefix",
    "action_probe.",
    "--",
    "/path/to/verdiwm-runs/ctrl-world/runtime-probe-v1/bin/python",
    "/path/to/VerdiWM/scripts/run_ctrl_world_replay_action_probe.py",
    "--ctrl-world-root",
    "/path/to/Ctrl-World",
    "--dataset-root",
    "/path/to/Ctrl-World/dataset_example/droid_subset",
    "--data-stat",
    "/path/to/Ctrl-World/dataset_meta_info/droid_subset/stat.json",
    "--svd-model-path",
    "/path/to/model/ctrl-world/stable-video-diffusion-img2vid",
    "--clip-model-path",
    "/path/to/model/ctrl-world/clip-vit-base-patch32",
    "--ckpt-path",
    "/path/to/model/ctrl-world/Ctrl-World/checkpoint-10000.pt",
    "--episodes-json",
    "/path/to/VerdiWM/configs/probes/ctrl_world_replay_action_scale_probe_smoke_v1.episodes.json",
    "--probe-id",
    "action_conditioning_scale",
    "--doses",
    "0.0",
    "--interact-num",
    "2",
    "--num-inference-steps",
    "2",
    "--output-root",
    "{scratch_dir}/external-output"
  ],
  "working_directory": ".",
  "allowed_gpu_indices": [0, 1, 4, 5, 6, 7],
  "estimated_gpu_hours": 0.04,
  "total_budget_gpu_hours": 0.04,
  "timeout_seconds": 600,
  "gpu_wait_seconds": 20,
  "sample_interval_seconds": 0.2,
  "result_path": "result.json",
  "artifacts": [
    "result.json",
    "artifact-index.json",
    "action-probe-result.json",
    "rollout.mp4",
    "external-stdout.log",
    "external-stderr.log"
  ],
  "metric_gates": [
    {"metric": "runtime_ready", "role": "primary", "operator": "gte", "threshold": 1.0},
    {"metric": "action_probe.probe_ready", "role": "protected", "operator": "gte", "threshold": 1.0},
    {"metric": "action_probe.episode_count", "role": "protected", "operator": "gte", "threshold": 1.0},
    {"metric": "action_probe.baseline_hook_invocations", "role": "protected", "operator": "gte", "threshold": 2.0},
    {"metric": "external_exit_code", "role": "protected", "operator": "lte", "threshold": 0.0},
    {"metric": "artifact_count", "role": "protected", "operator": "gte", "threshold": 2.0},
    {"metric": "gpu_identity_match", "role": "protected", "operator": "gte", "threshold": 1.0}
  ],
  "environment": {
    "PYTHONUNBUFFERED": "1",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "TOKENIZERS_PARALLELISM": "false",
    "WANDB_MODE": "disabled",
    "HF_HOME": "{scratch_dir}/cache/huggingface",
    "XDG_CACHE_HOME": "{scratch_dir}/cache"
  },
  "cleanup_policy": "archive_then_delete"
}
