{
  "schema_version": 1,
  "artifact_type": "verdiwm-diagnostic-probe-contract",
  "probe_id": "ctrl-world-paired-video-diagnostic-v2",
  "objective": "Measure paired predictive-video error, horizon coverage, and temporal response on one frozen Ctrl-World replay.",
  "hypothesis": "The admitted one-interaction Ctrl-World replay exposes a reproducible paired-video failure signature that should determine the next bounded screen.",
  "selection_reason": "A single frozen replay is the lowest-cost diagnostic that uses the already admitted checkpoint and dataset while producing a receipt-bound failure signature.",
  "falsification_criterion": "The probe is blocked unless the child replay exits cleanly, exactly one paired video is archived, and the diagnostic JSON is schema-valid with physical-GPU evidence.",
  "command": [
    "{python}",
    "-m",
    "wmloop.execute.external_evaluator_workload",
    "--artifact",
    "external-output/**/*.mp4=rollout.mp4",
    "--artifact",
    "diagnostic-output.json=diagnostic-output.json",
    "--metrics-artifact",
    "diagnostic-output.json",
    "--metric-prefix",
    "diagnostic.",
    "--",
    "{python}",
    "-m",
    "wmloop.diagnose.external_video_probe",
    "--video-pattern",
    "external-output/**/*.mp4",
    "--output-path",
    "diagnostic-output.json",
    "--model-family",
    "ctrl-world",
    "--runtime-capability",
    "predictive-video",
    "--layout",
    "vertical",
    "--max-frames",
    "64",
    "--min-frames",
    "8",
    "--max-pair-l1",
    "10.0",
    "--min-pred-temporal-change",
    "1.0",
    "--max-horizon-drift-slope",
    "0.5",
    "--fallback-signature",
    "no_declared_failure_detected",
    "--",
    "{python}",
    "-c",
    "import os,runpy,imageio_ffmpeg,mediapy; mediapy.set_ffmpeg(imageio_ffmpeg.get_ffmpeg_exe()); from config import wm_args; original=wm_args.__post_init__; wm_args.__post_init__=lambda self:(original(self),setattr(self,'val_id',self.val_id[:1]),setattr(self,'start_idx',self.start_idx[:1]),setattr(self,'instruction',self.instruction[:1]),setattr(self,'interact_num',1),setattr(self,'num_inference_steps',2),setattr(self,'save_dir',os.path.join(os.environ['VERDIWM_TRIAL_SCRATCH'],'external-output'))); runpy.run_path('scripts/rollout_replay_traj.py',run_name='__main__')",
    "--dataset_root_path",
    "{asset:--dataset_root_path}",
    "--dataset_meta_info_path",
    "{asset:--dataset_meta_info_path}",
    "--dataset_names",
    "droid_subset",
    "--svd_model_path",
    "{asset:--svd_model_path}",
    "--clip_model_path",
    "{asset:--clip_model_path}",
    "--ckpt_path",
    "{asset:--ckpt_path}",
    "--task_type",
    "replay"
  ],
  "working_directory": ".",
  "allowed_gpu_indices": [0, 1, 4, 5, 6, 7],
  "estimated_gpu_hours": 0.08,
  "total_budget_gpu_hours": 0.08,
  "timeout_seconds": 600,
  "gpu_wait_seconds": 20,
  "sample_interval_seconds": 0.2,
  "result_path": "result.json",
  "diagnostic_result_path": "diagnostic-output.json",
  "artifacts": [
    "result.json",
    "artifact-index.json",
    "diagnostic-output.json",
    "rollout.mp4",
    "external-stdout.log",
    "external-stderr.log"
  ],
  "metric_gates": [
    {
      "metric": "runtime_ready",
      "role": "primary",
      "operator": "gte",
      "threshold": 1.0
    },
    {
      "metric": "diagnostic.probe_ready",
      "role": "protected",
      "operator": "gte",
      "threshold": 1.0
    },
    {
      "metric": "external_exit_code",
      "role": "protected",
      "operator": "lte",
      "threshold": 0.0
    },
    {
      "metric": "artifact_count",
      "role": "protected",
      "operator": "gte",
      "threshold": 2.0
    },
    {
      "metric": "gpu_identity_match",
      "role": "protected",
      "operator": "gte",
      "threshold": 1.0
    }
  ],
  "environment": {
    "PATH": "{runtime_path}",
    "PYTHONPATH": "{verdiwm_root}",
    "PYTHONUNBUFFERED": "1",
    "HF_HUB_OFFLINE": "1",
    "TRANSFORMERS_OFFLINE": "1",
    "TOKENIZERS_PARALLELISM": "false",
    "WANDB_MODE": "disabled",
    "HF_HOME": "{scratch_dir}/cache/huggingface",
    "XDG_CACHE_HOME": "{scratch_dir}/cache"
  },
  "cleanup_policy": "archive_then_delete",
  "model_family": "ctrl-world",
  "runtime_capability": "predictive-video",
  "failure_signature_fields": [
    "failure_signatures",
    "metrics",
    "video"
  ]
}
