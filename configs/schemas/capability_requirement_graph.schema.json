{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "graph_id", "graph_digest", "goal_ir_id", "goal_ir_digest", "portrait_id", "portrait_digest", "registry_id", "registry_digest", "nodes", "edges", "claim_boundary"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-capability-requirement-graph"]},
    "graph_id": {"type": "string", "pattern": "^capability-graph-[0-9a-f]{24}$"},
    "graph_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "goal_ir_id": {"type": "string", "pattern": "^goal-ir-[0-9a-f]{24}$"},
    "goal_ir_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "portrait_id": {"type": "string", "pattern": "^model-portrait-[0-9a-f]{24}$"},
    "portrait_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_id": {"type": "string", "minLength": 1},
    "registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "requirement_id", "capability", "kind", "dependencies", "classification", "reason_codes", "resolution"],
        "properties": {
          "node_id": {"type": "string", "pattern": "^capability-node-[0-9a-f]{24}$"},
          "requirement_id": {"type": "string", "pattern": "^requirement-[0-9a-f]{24}$"},
          "capability": {"type": "string", "minLength": 1},
          "kind": {"enum": ["observation", "interface", "data", "intervention", "evaluation", "evidence"]},
          "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^capability-node-[0-9a-f]{24}$"}},
          "classification": {"enum": ["satisfied", "reusable", "composable", "manufacturable", "interface_extension_required", "data_blocked", "architecture_bound"]},
          "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["native", "selected_abi_ids", "composition_id", "composition_digest", "manufacturing_abi_ids", "external_ports", "ranking_prior_ids"],
            "properties": {
              "native": {"type": "boolean"},
              "selected_abi_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "composition_id": {"type": ["string", "null"]},
              "composition_digest": {"type": ["string", "null"]},
              "manufacturing_abi_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "external_ports": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["port", "contract"],
                  "properties": {
                    "port": {"type": "string", "minLength": 1},
                    "contract": {"type": "string", "minLength": 1}
                  }
                }
              },
              "ranking_prior_ids": {"type": "array", "items": {"type": "string", "pattern": "^knowledge-prior-[0-9a-f]{24}$"}}
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "relation", "target"],
        "properties": {
          "source": {"type": "string", "pattern": "^capability-node-[0-9a-f]{24}$"},
          "relation": {"enum": ["requires"]},
          "target": {"type": "string", "pattern": "^capability-node-[0-9a-f]{24}$"}
        }
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
