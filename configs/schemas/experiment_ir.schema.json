{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "experiment_id",
    "version",
    "model_capability_digest",
    "objective",
    "hypothesis",
    "falsification_criterion",
    "workflow",
    "dataset",
    "training",
    "evaluation",
    "interventions",
    "budget",
    "artifacts",
    "authority",
    "launch"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-experiment-ir"]},
    "experiment_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "model_capability_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "objective": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "falsification_criterion": {"type": "string", "minLength": 1},
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_id", "workflow_version", "skills", "capability_digest"],
      "properties": {
        "workflow_id": {"type": "string", "minLength": 1},
        "workflow_version": {"type": "string", "minLength": 1},
        "skills": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "capability_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freeze_id", "split_policy", "mutation_policy"],
      "properties": {
        "freeze_id": {"type": "string", "pattern": "^dataset-freeze:(semantic|sha256):[0-9a-f]{64}$"},
        "split_policy": {"type": "string", "minLength": 1},
        "mutation_policy": {"enum": ["frozen"]}
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "batch_size", "gradient_accumulation", "world_size", "sequence_length", "seed_count", "plan_digest"],
      "properties": {
        "stage": {"enum": ["smoke", "screen", "pilot", "confirm"]},
        "batch_size": {"type": "integer", "minimum": 1},
        "gradient_accumulation": {"type": "integer", "minimum": 1},
        "world_size": {"type": "integer", "minimum": 1},
        "sequence_length": {"type": ["integer", "null"], "minimum": 1},
        "seed_count": {"type": "integer", "minimum": 1},
        "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "horizons", "seeds", "heldout_protocol", "evaluator_digest"],
      "properties": {
        "metrics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "horizons": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "seeds": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
        "heldout_protocol": {"type": "string", "minLength": 1},
        "evaluator_digest": {"type": ["string", "null"]}
      }
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["primitive_id", "semantic_intent", "target_hooks", "mutation_scope"],
        "properties": {
          "primitive_id": {"type": "string", "minLength": 1},
          "semantic_intent": {"type": "string", "minLength": 1},
          "target_hooks": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "mutation_scope": {"enum": ["proposal_only", "bounded_runtime", "source_code"]}
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_gpu_hours", "max_trials"],
      "properties": {
        "max_gpu_hours": {"type": "number", "exclusiveMinimum": 0},
        "max_trials": {"type": "integer", "minimum": 1}
      }
    },
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_policy", "data_split_policy", "promotion_policy"],
      "properties": {
        "evaluator_policy": {"enum": ["frozen"]},
        "data_split_policy": {"enum": ["frozen"]},
        "promotion_policy": {"enum": ["verifier_only"]}
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "blockers"],
      "properties": {
        "state": {"enum": ["not_started", "blocked"]},
        "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
