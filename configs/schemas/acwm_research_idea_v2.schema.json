{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "idea_id", "source", "track", "transfer_mode", "failure_context", "source_evidence", "materialization_contract", "objective", "hypothesis", "falsification_criterion", "required_protocol", "synthesis_method", "execution_state", "claim_boundary"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [2]},
    "artifact_type": {"enum": ["verdiwm-acwm-research-idea"]},
    "idea_id": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "track": {"type": "string", "minLength": 1},
    "transfer_mode": {"enum": ["mechanism_transfer"]},
    "failure_context": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "materialization_contract": {"type": "object"},
    "objective": {"type": "string", "minLength": 12},
    "hypothesis": {"type": "string", "minLength": 12},
    "falsification_criterion": {"type": "string", "minLength": 12},
    "required_protocol": {"type": "array", "minItems": 3, "items": {"enum": ["screen", "confirm", "frozen_verifier"]}},
    "synthesis_method": {"enum": ["source_component_grounding_v2"]},
    "execution_state": {"enum": ["materialization_required"]},
    "claim_boundary": {"type": "string", "minLength": 12}
  }
}
