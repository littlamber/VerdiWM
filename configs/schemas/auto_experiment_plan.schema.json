{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "campaign_id",
    "trial_id",
    "objective",
    "hypothesis",
    "selection_reason",
    "falsification_criterion",
    "stage",
    "command",
    "working_directory",
    "allowed_gpu_indices",
    "estimated_gpu_hours",
    "total_budget_gpu_hours",
    "timeout_seconds",
    "gpu_wait_seconds",
    "sample_interval_seconds",
    "result_path",
    "artifacts",
    "metric_gates",
    "environment",
    "cleanup_policy"
  ],
  "properties": {
    "schema_version": {"enum": [1]},
    "artifact_type": {"enum": ["verdiwm-auto-experiment-plan"]},
    "campaign_id": {"type": "string", "minLength": 1},
    "trial_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "objective": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "selection_reason": {"type": "string", "minLength": 1},
    "falsification_criterion": {"type": "string", "minLength": 1},
    "stage": {"enum": ["smoke", "screen", "gate", "confirm"]},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "working_directory": {"type": "string", "minLength": 1},
    "allowed_gpu_indices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "estimated_gpu_hours": {"type": "number", "exclusiveMinimum": 0},
    "total_budget_gpu_hours": {"type": "number", "exclusiveMinimum": 0},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "gpu_wait_seconds": {"type": "number", "minimum": 0},
    "sample_interval_seconds": {"type": "number", "exclusiveMinimum": 0},
    "result_path": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "metric_gates": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "environment": {"type": "object"},
    "cleanup_policy": {"enum": ["retain", "archive_then_delete"]},
    "human_approved": {"type": "boolean"}
    ,
    "onboarding_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_path", "receipt_sha256", "onboarding_report_sha256"],
      "properties": {
        "receipt_path": {"type": "string", "minLength": 1},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "onboarding_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
