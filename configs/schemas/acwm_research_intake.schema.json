{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "policy_id", "policy_digest", "contract_id", "contract_digest", "queries", "source_policy", "idea_policy", "execution_policy"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-acwm-research-intake"]},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 8}
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "max_results_per_source", "timeout_seconds", "response_byte_limit"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["arxiv", "github", "openalex"]}
        },
        "max_results_per_source": {"type": "integer", "minimum": 1, "maximum": 20},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
        "response_byte_limit": {"type": "integer", "minimum": 1024, "maximum": 2000000},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 5},
        "retry_backoff_seconds": {"type": "number", "minimum": 0, "maximum": 10}
      }
    },
    "idea_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_ideas", "min_external_sources", "allowed_tracks"],
      "properties": {
        "max_ideas": {"type": "integer", "minimum": 1, "maximum": 32},
        "min_external_sources": {"type": "integer", "minimum": 1, "maximum": 32},
        "allowed_tracks": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["action_conditioning", "long_horizon_memory", "training_inference_alignment", "rollout_stability"]}
        }
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_stages", "source_code_mutation", "promotion_authority"],
      "properties": {
        "required_stages": {
          "type": "array",
          "minItems": 3,
          "items": {"enum": ["screen", "confirm", "frozen_verifier"]}
        },
        "source_code_mutation": {"enum": ["materialization_required"]},
        "promotion_authority": {"enum": ["frozen_verifier_only"]}
      }
    }
  }
}
