{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "env", "model_ref", "round", "goal_id", "verdict_probe_ids", "probes", "evidence_frames"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "artifact_type": {"enum": ["wmloop-verdict-evidence"]},
    "env": {"type": "string", "minLength": 1},
    "model_ref": {"type": "string", "minLength": 1},
    "round": {"type": "integer", "minimum": 0},
    "goal_id": {"type": "string", "minLength": 1},
    "verdict_probe_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "probes": {"type": "object"},
    "evidence_frames": {"type": "array", "items": {"type": "string"}}
  }
}
