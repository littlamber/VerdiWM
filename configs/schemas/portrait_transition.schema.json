{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "transition_id", "parent_portrait_id", "parent_portrait_digest", "portrait_id", "portrait_digest", "embodiment_id", "transition_ref", "outcome_state", "evaluator_binding", "verdict_ref", "evidence_refs", "claim_scope"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-portrait-transition"]},
    "transition_id": {"type": "string", "pattern": "^portrait-transition-[0-9a-f]{24}$"},
    "parent_portrait_id": {"type": "string", "pattern": "^model-portrait-[0-9a-f]{24}$"},
    "parent_portrait_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "portrait_id": {"type": "string", "pattern": "^model-portrait-[0-9a-f]{24}$"},
    "portrait_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "embodiment_id": {"type": "string", "minLength": 1},
    "transition_ref": {"type": "string", "pattern": "^(cas://|urn:|sha256:)"},
    "outcome_state": {"enum": ["admitted", "target_confirmed", "verified_negative_boundary"]},
    "evaluator_binding": {"type": ["string", "null"]},
    "verdict_ref": {"type": ["string", "null"]},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(cas://|urn:|sha256:)"}},
    "claim_scope": {"enum": ["ranking_only", "target_local"]}
  }
}
