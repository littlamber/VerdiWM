{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "overlay_id",
    "method_id",
    "base_revision",
    "files",
    "tests",
    "authority",
    "state",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"enum": [1]},
    "artifact_type": {"enum": ["verdiwm-candidate-overlay"]},
    "overlay_id": {"type": "string", "pattern": "^overlay-[0-9a-f]{24}$"},
    "method_id": {"type": "string", "pattern": "^method-ir-[0-9a-f]{24}$"},
    "method_ir_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_contract_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id", "contract_digest"],
      "properties": {
        "execution_id": {"type": "string", "pattern": "^candidate-execution-[0-9a-f]{24}$"},
        "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "base_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "source_digest"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "source_digest": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-f]{64}$"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "sha256", "role"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role": {"enum": ["implementation", "configuration", "test", "descriptor"]}
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "state"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "state": {"enum": ["declared", "passed", "failed"]}
        }
      }
    },
    "target_portrait_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portrait_id", "portrait_digest"],
      "properties": {
        "portrait_id": {"type": "string", "pattern": "^model-portrait-[0-9a-f]{24}$"},
        "portrait_digest": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-f]{64}$"}
      }
    },
    "probe_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint_ids", "coverage_keys", "binding_digest"],
      "properties": {
        "fingerprint_ids": {"type": "array", "items": {"type": "string", "pattern": "^fingerprint-[0-9a-f]{24}$"}},
        "coverage_keys": {"type": "array", "items": {"type": "string", "pattern": "^probe-coverage-[0-9a-f]{24}$"}},
        "binding_digest": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-f]{64}$"}
      }
    },
    "interface_extension_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^method-interface-extension-[0-9a-f]{24}$"}
    },
    "training_resource_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planner_id", "plan_digest", "execution_mode", "world_size"],
      "properties": {
        "planner_id": {"type": "string", "minLength": 1},
        "plan_digest": {"type": "string", "pattern": "^(?:sha256:)?[0-9a-f]{64}$"},
        "execution_mode": {"enum": ["runtime_only", "single_gpu", "distributed"]},
        "world_size": {"type": "integer", "minimum": 0}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_mutation_allowed", "evaluator_mutation_allowed", "metric_mutation_allowed", "gpu_authority"],
      "properties": {
        "source_mutation_allowed": {"const": false},
        "evaluator_mutation_allowed": {"const": false},
        "metric_mutation_allowed": {"const": false},
        "gpu_authority": {"const": false}
      }
    },
    "state": {"enum": ["proposed", "validated", "calibrated", "rejected"]},
    "claim_boundary": {"type": "string", "minLength": 12}
  }
}
