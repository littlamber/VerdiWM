{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "execution_id", "study_id", "state",
    "input_binding", "split_validation", "calibrations", "trials",
    "selection_summary", "confirmation_settlement", "knowledge",
    "resource_usage", "authority", "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "verdiwm-open-method-study-execution"},
    "execution_id": {"type": "string", "pattern": "^open-execution-[0-9a-f]{24}$"},
    "study_id": {"type": "string", "pattern": "^open-study-[0-9a-f]{24}$"},
    "state": {"enum": ["completed", "abstained", "failed"]},
    "input_binding": {"type": "object"},
    "split_validation": {"type": "object"},
    "calibrations": {"type": "array", "minItems": 1},
    "trials": {"type": "array"},
    "selection_summary": {"type": "object"},
    "confirmation_settlement": {"type": "object"},
    "knowledge": {"type": "object"},
    "resource_usage": {"type": "object"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["local_evidence", "community_projection", "promotion"],
      "properties": {
        "local_evidence": {"type": "boolean"},
        "community_projection": {"const": false},
        "promotion": {"const": false}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 12}
  }
}
