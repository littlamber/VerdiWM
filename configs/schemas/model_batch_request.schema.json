{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "batch_id", "goal", "models"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-model-batch-request"]},
    "batch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "goal": {"type": "string", "minLength": 1},
    "budget": {"type": ["string", "number", "object"]},
    "target_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "models": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["model_id", "model", "data"],
        "properties": {
          "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
          "model": {"type": "string", "minLength": 1},
          "data": {"type": "string", "minLength": 1},
          "goal": {"type": "string", "minLength": 1},
          "budget": {"type": ["string", "number", "object"]},
          "adapter": {"type": "string", "minLength": 1},
          "adapter_profile": {"type": "string", "minLength": 1},
          "runtime_python": {"type": "string", "minLength": 1},
          "evaluator_contract": {"type": "string", "minLength": 1},
          "instance_config": {"type": "string", "minLength": 1},
          "source_revision": {"type": "string", "minLength": 1},
          "dataset_freeze": {"type": "string", "minLength": 1},
          "target_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "assets": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
