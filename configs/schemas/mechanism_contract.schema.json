{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "mechanism_id",
    "causal_claim",
    "intervention_semantics",
    "required_capabilities",
    "optional_capabilities",
    "target_interface_requirements",
    "prohibited_substitutions",
    "required_ablations",
    "falsification_criterion",
    "known_anti_conditions",
    "source_evidence_refs"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-mechanism-contract"]},
    "mechanism_id": {"type": "string", "pattern": "^mechanism-[0-9a-f]{24}$"},
    "causal_claim": {"type": "string", "minLength": 1},
    "intervention_semantics": {"type": "string", "minLength": 1},
    "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "optional_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "target_interface_requirements": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "prohibited_substitutions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "required_ablations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "falsification_criterion": {"type": "string", "minLength": 1},
    "known_anti_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^(cas://|urn:|sha256:)"}
    }
  }
}
