{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "task_id", "task_type", "prompt_template_digest", "output_schema", "input"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-llm-research-task"]},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "task_type": {"enum": ["source_assessment", "experiment_plan", "module_generation", "open_method_generation", "evidence_interpretation"]},
    "prompt_template_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_schema": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "input": {"type": "object"}
  }
}
