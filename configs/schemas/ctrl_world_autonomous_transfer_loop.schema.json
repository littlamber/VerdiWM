{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "loop_id",
    "config_digest",
    "poll_seconds",
    "discovery_interval_seconds",
    "max_parallel_gpu_jobs",
    "max_operational_retries",
    "gpu_indices",
    "gpu_lock_root",
    "gpu_wait_seconds",
    "activity_probe_seconds",
    "worker_timeout_seconds",
    "paths",
    "materializers",
    "existing_evidence_roots",
    "knowledge_graph_root"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-ctrl-world-autonomous-transfer-loop"]},
    "loop_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "poll_seconds": {"type": "number", "minimum": 1},
    "discovery_interval_seconds": {"type": "number", "minimum": 60},
    "max_parallel_gpu_jobs": {"type": "integer", "minimum": 1, "maximum": 8},
    "max_operational_retries": {"type": "integer", "minimum": 0, "maximum": 10},
    "gpu_indices": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 0}
    },
    "gpu_lock_root": {"type": "string", "minLength": 1},
    "gpu_wait_seconds": {"type": "number", "minimum": 0},
    "activity_probe_seconds": {"type": "integer", "minimum": 0, "maximum": 120},
    "worker_timeout_seconds": {"type": "number", "minimum": 60},
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_root",
        "ctrl_world_root",
        "dataset_root",
        "data_stat",
        "checkpoint",
        "svd_model",
        "clip_model",
        "runtime_python",
        "intake_config",
        "contract",
        "evaluator",
        "base_evaluator",
        "screen_baseline",
        "confirm_baseline",
        "verifier_policy"
      ],
      "properties": {
        "project_root": {"type": "string", "minLength": 1},
        "ctrl_world_root": {"type": "string", "minLength": 1},
        "dataset_root": {"type": "string", "minLength": 1},
        "data_stat": {"type": "string", "minLength": 1},
        "checkpoint": {"type": "string", "minLength": 1},
        "svd_model": {"type": "string", "minLength": 1},
        "clip_model": {"type": "string", "minLength": 1},
        "runtime_python": {"type": "string", "minLength": 1},
        "intake_config": {"type": "string", "minLength": 1},
        "contract": {"type": "string", "minLength": 1},
        "evaluator": {"type": "string", "minLength": 1},
        "base_evaluator": {"type": "string", "minLength": 1},
        "screen_baseline": {"type": "string", "minLength": 1},
        "confirm_baseline": {"type": "string", "minLength": 1},
        "verifier_policy": {"type": "string", "minLength": 1}
      }
    },
    "materializers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plan_template"],
        "properties": {
          "plan_template": {"type": "string", "minLength": 1},
          "evaluator": {"type": "string", "minLength": 1},
          "trainer": {"type": "string", "minLength": 1},
          "training": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "steps": {"type": "integer", "minimum": 1},
              "batch_size": {"type": "integer", "minimum": 1},
              "learning_rate": {"type": "number", "exclusiveMinimum": 0},
              "max_grad_norm": {"type": "number", "exclusiveMinimum": 0},
              "seed": {"type": "integer"},
              "num_history": {"type": "integer", "minimum": 1},
              "num_frames": {"type": "integer", "minimum": 1},
              "split_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "device": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "local_method_discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "intake_config", "materializer_profiles", "max_methods"],
      "properties": {
        "enabled": {"type": "boolean"},
        "intake_config": {"type": "string", "minLength": 1},
        "materializer_profiles": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "max_methods": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "metric_evolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "protected_metric_ids", "candidate_metrics"],
      "properties": {
        "mode": {"enum": ["shadow_only"]},
        "protected_metric_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "candidate_metrics": {
          "type": "array",
          "items": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "automatic_module_generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_capability_ir", "abi_registry", "llm_adapter"],
      "properties": {
        "model_capability_ir": {"type": "string", "minLength": 1},
        "abi_registry": {"type": "string", "minLength": 1},
        "llm_adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "provider_alias", "model_alias", "timeout_seconds", "max_output_bytes", "credential_environment_keys"],
          "properties": {
            "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "provider_alias": {"type": "string", "minLength": 1},
            "model_alias": {"type": "string", "minLength": 1},
            "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
            "max_output_bytes": {"type": "integer", "minimum": 1},
            "credential_environment_keys": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "open_method_generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["llm_adapter"],
      "properties": {
        "llm_adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "provider_alias", "model_alias", "timeout_seconds", "max_output_bytes", "credential_environment_keys"],
          "properties": {
            "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "provider_alias": {"type": "string", "minLength": 1},
            "model_alias": {"type": "string", "minLength": 1},
            "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
            "max_output_bytes": {"type": "integer", "minimum": 1},
            "credential_environment_keys": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "calibration_adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "provider_alias", "model_alias", "timeout_seconds", "max_output_bytes", "credential_environment_keys"],
          "properties": {
            "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "provider_alias": {"type": "string", "minLength": 1},
            "model_alias": {"type": "string", "minLength": 1},
            "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
            "max_output_bytes": {"type": "integer", "minimum": 1},
            "credential_environment_keys": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "external_research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network_required", "minimum_successful_sources"],
      "properties": {
        "network_required": {"type": "boolean"},
        "minimum_successful_sources": {"type": "integer", "minimum": 1, "maximum": 8}
      }
    },
    "portrait_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_portrait",
        "model_portrait_sha256",
        "coverage_policy_id",
        "requirements"
      ],
      "properties": {
        "model_portrait": {"type": "string", "minLength": 1},
        "model_portrait_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "coverage_policy_id": {"type": "string", "minLength": 1},
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "capabilities",
            "execution_interfaces",
            "hooks",
            "probe_coverage",
            "operational_metrics",
            "evaluator_required"
          ],
          "properties": {
            "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "execution_interfaces": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "contract_id"],
                "properties": {
                  "kind": {"type": "string", "minLength": 1},
                  "contract_id": {"type": "string", "minLength": 1}
                }
              }
            },
            "hooks": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "probe_coverage": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "probe_protocol_id",
                  "probe_protocol_version",
                  "diagnostic_role",
                  "context_class",
                  "split",
                  "horizons",
                  "dose_values",
                  "minimum_replication_count"
                ],
                "properties": {
                  "probe_protocol_id": {"type": "string", "minLength": 1},
                  "probe_protocol_version": {"type": "string", "pattern": "^v[0-9]+$"},
                  "diagnostic_role": {"enum": ["diagnostic", "ranking", "transfer_screen"]},
                  "context_class": {"type": "string", "minLength": 1},
                  "split": {"type": "string", "minLength": 1},
                  "horizons": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
                  "dose_values": {"type": "array", "minItems": 1, "items": {"type": "number"}},
                  "minimum_replication_count": {"type": "integer", "minimum": 1}
                }
              }
            },
            "operational_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "evaluator_required": {"type": "boolean"}
          }
        }
      }
    },
    "observation_planning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["abi_registry"],
      "properties": {
        "abi_registry": {"type": "string", "minLength": 1}
      }
    },
    "observation_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_root", "runtime_bindings", "adapters", "shadow_llm_adapter"],
      "properties": {
        "archive_root": {"type": "string", "minLength": 1},
        "runtime_bindings": {
          "type": "object",
          "additionalProperties": {"type": "object"}
        },
        "adapters": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "timeout_seconds", "max_output_bytes", "resource_class", "environment"],
            "properties": {
              "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
              "max_output_bytes": {"type": "integer", "minimum": 1},
              "resource_class": {"enum": ["cpu_only", "diagnostic_gpu"]},
              "environment": {
                "type": "object",
                "additionalProperties": {"type": "string"}
              }
            }
          }
        },
        "shadow_llm_adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "provider_alias", "model_alias", "timeout_seconds", "max_output_bytes", "credential_environment_keys"],
          "properties": {
            "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "provider_alias": {"type": "string", "minLength": 1},
            "model_alias": {"type": "string", "minLength": 1},
            "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
            "max_output_bytes": {"type": "integer", "minimum": 1},
            "credential_environment_keys": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "gap_planning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abi_registry",
        "abi_registry_digest",
        "maximum_authority_level",
        "admitted_abi_ids",
        "available_data_regimes",
        "kernel_capabilities",
        "profile_requirements"
      ],
      "properties": {
        "abi_registry": {"type": "string", "minLength": 1},
        "abi_registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "maximum_authority_level": {"enum": ["L0", "L1", "L2"]},
        "admitted_abi_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "available_data_regimes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "kernel_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "portable_knowledge_graph": {"type": "string", "minLength": 1},
        "portable_knowledge_graph_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "profile_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile_id", "requirements"],
            "properties": {
              "profile_id": {"type": "string", "minLength": 1},
              "requirements": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["capability", "kind", "dependencies", "required_model_capabilities", "required_hooks", "required_interfaces", "required_probe_keys", "required_data_regimes", "compatible_model_families", "manufacturable", "external_ports", "source"],
                  "properties": {
                    "capability": {"type": "string", "minLength": 1},
                    "kind": {"enum": ["observation", "interface", "data", "intervention", "evaluation", "evidence"]},
                    "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
                    "required_model_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
                    "required_hooks": {"type": "array", "items": {"type": "string", "minLength": 1}},
                    "required_interfaces": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["kind", "contract_id"],
                        "properties": {
                          "kind": {"type": "string", "minLength": 1},
                          "contract_id": {"type": "string", "minLength": 1}
                        }
                      }
                    },
                    "required_probe_keys": {"type": "array", "items": {"type": "string", "pattern": "^probe-coverage-[0-9a-f]{24}$"}},
                    "required_data_regimes": {"type": "array", "items": {"type": "string", "minLength": 1}},
                    "compatible_model_families": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                    "manufacturable": {"type": "boolean"},
                    "external_ports": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["port", "contract"],
                        "properties": {
                          "port": {"type": "string", "minLength": 1},
                          "contract": {"type": "string", "minLength": 1}
                        }
                      }
                    },
                    "source": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      }
    },
    "portfolio_planning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis_batch",
        "hypothesis_batch_sha256",
        "policy_id",
        "maximum_hypotheses",
        "max_total_gpu_hours",
        "minimum_replications",
        "baseline_gpu_hours",
        "control_cost_fraction",
        "ablation_cost_fraction",
        "protected_metrics",
        "heldout_protocol",
        "required_artifact_classes"
      ],
      "properties": {
        "hypothesis_batch": {"type": "string", "minLength": 1},
        "hypothesis_batch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "policy_id": {"type": "string", "minLength": 1},
        "maximum_hypotheses": {"type": "integer", "minimum": 1},
        "max_total_gpu_hours": {"type": "number", "exclusiveMinimum": 0},
        "minimum_replications": {"type": "integer", "minimum": 1},
        "baseline_gpu_hours": {"type": "number", "minimum": 0},
        "control_cost_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "ablation_cost_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "protected_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "heldout_protocol": {"type": "string", "minLength": 1},
        "required_artifact_classes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "resource_portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "resource_allocation",
        "experiment_scale_plan",
        "experiment_scale_plan_sha256",
        "conversion_scale_plan",
        "conversion_scale_plan_sha256",
        "default_confirm_gpu_count"
      ],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "resource_allocation": {"type": "object", "additionalProperties": true},
        "experiment_scale_plan": {"type": "string", "minLength": 1},
        "experiment_scale_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "conversion_scale_plan": {"type": "string", "minLength": 1},
        "conversion_scale_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "default_confirm_gpu_count": {"type": "integer", "minimum": 1, "maximum": 6},
        "confirm_gpu_count_by_profile": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 6}
        },
        "training_scale_plans": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "scale_rationales": {
          "type": "object",
          "additionalProperties": {"type": "object", "additionalProperties": true}
        }
      }
    },
    "closed_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_information_gain",
        "maximum_replans",
        "stop_on_confirmed_positive",
        "archive_root"
      ],
      "properties": {
        "minimum_information_gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maximum_replans": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "stop_on_confirmed_positive": {"type": "boolean"},
        "archive_root": {"type": "string", "minLength": 1},
        "active_portrait_path": {"type": "string", "minLength": 1},
        "active_portrait_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "existing_evidence_roots": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "source_bundle_path": {"type": "string", "minLength": 1},
    "knowledge_graph_root": {"type": "string", "minLength": 1},
    "portable_knowledge_root": {"type": "string", "minLength": 1},
    "portable_knowledge_records_root": {"type": "string", "minLength": 1}
  }
}
