{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "decision_id",
    "work_id",
    "trigger",
    "state",
    "selected_task",
    "stop_reason",
    "ranked_tasks",
    "signals",
    "authority",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-closed-loop-next-task"]},
    "decision_id": {"type": "string", "pattern": "^closed-loop-decision-[0-9a-f]{24}$"},
    "work_id": {"type": "string", "minLength": 1},
    "trigger": {"type": "string", "minLength": 1},
    "state": {"enum": ["continue", "stop"]},
    "selected_task": {"enum": ["observe_portrait", "discover_intervention", "stop"]},
    "stop_reason": {
      "type": ["string", "null"],
      "enum": [
        null,
        "success",
        "exhausted_budget",
        "insufficient_evidence",
        "architecture_mismatch",
        "unresolved_policy_gap",
        "low_information_gain",
        "duplicate_candidate",
        "stale_portrait",
        "protocol_drift",
        "cleanup_failure",
        "authority_violation",
        "non_portable_knowledge"
      ]
    },
    "ranked_tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task", "rank", "score", "reason"],
        "properties": {
          "task": {"enum": ["observe_portrait", "discover_intervention", "stop"]},
          "rank": {"type": "integer", "minimum": 1},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "residual",
        "counterexample",
        "uncertainty",
        "information_gain",
        "stale_portrait",
        "replan_count"
      ],
      "properties": {
        "residual": {"type": "number", "minimum": 0, "maximum": 1},
        "counterexample": {"type": "number", "minimum": 0, "maximum": 1},
        "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
        "information_gain": {"type": "number", "minimum": 0, "maximum": 1},
        "stale_portrait": {"type": "boolean"},
        "replan_count": {"type": "integer", "minimum": 0}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_authority", "evaluator_authority", "promotion_authority", "model_mutation_authority"],
      "properties": {
        "gpu_authority": {"enum": [false]},
        "evaluator_authority": {"enum": [false]},
        "promotion_authority": {"enum": [false]},
        "model_mutation_authority": {"enum": [false]}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
