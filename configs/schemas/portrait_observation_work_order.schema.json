{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "observation_id",
    "state",
    "work_id",
    "idea_id",
    "portrait_id",
    "readiness_id",
    "readiness_state",
    "goal_binding",
    "blockers",
    "requirements",
    "authority"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-portrait-observation-work-order"]},
    "observation_id": {"type": "string", "pattern": "^portrait-observation-[0-9a-f]{24}$"},
    "state": {"enum": ["pending"]},
    "work_id": {"type": "string", "minLength": 1},
    "idea_id": {"type": "string", "minLength": 1},
    "portrait_id": {"type": "string", "pattern": "^model-portrait-[0-9a-f]{24}$"},
    "readiness_id": {"type": "string", "pattern": "^portrait-readiness-[0-9a-f]{24}$"},
    "readiness_state": {
      "enum": [
        "requires_static_onboarding",
        "requires_probe_coverage",
        "requires_interface_extension",
        "requires_evaluator_binding",
        "conflicting_evidence",
        "stale_portrait"
      ]
    },
    "goal_binding": {"type": "string", "pattern": "^(cas://|urn:|sha256:)"},
    "blockers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "requirements": {"type": "object"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_authority", "intervention_authority", "promotion_authority"],
      "properties": {
        "gpu_authority": {"enum": [false]},
        "intervention_authority": {"enum": [false]},
        "promotion_authority": {"enum": [false]}
      }
    }
  }
}
