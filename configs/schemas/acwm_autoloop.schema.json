{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "loop_id", "loop_digest", "contract_id", "contract_digest", "max_refinement_rounds", "watch_poll_seconds", "seed_policy", "stop_conditions"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-acwm-autoloop"]},
    "loop_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "loop_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "max_refinement_rounds": {"type": "integer", "minimum": 1, "maximum": 8},
    "watch_poll_seconds": {"type": "integer", "minimum": 5, "maximum": 3600},
    "seed_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "required_confirm_blocker", "candidate_kind", "guidance_candidates"],
      "properties": {
        "policy_id": {"enum": ["guidance_boundary_refinement"]},
        "required_confirm_blocker": {"enum": ["PROTECTED_REGRESSION:horizon_drift_slope"]},
        "candidate_kind": {"enum": ["inference_guidance_scale"]},
        "guidance_candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_id", "guidance_scale"],
            "properties": {
              "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
              "guidance_scale": {"type": "number", "exclusiveMinimum": 1}
            }
          }
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
