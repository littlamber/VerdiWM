{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "registry_id", "plugins", "workflows"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-workflow-plugin-registry"]},
    "registry_id": {"type": "string", "minLength": 1},
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plugin_id", "version", "role", "input_contract", "output_artifact", "side_effect", "cost_model", "cross_model_safe", "authority_level", "required_model_capabilities"],
        "properties": {
          "plugin_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "input_contract": {"type": "string", "minLength": 1},
          "output_artifact": {"type": "string", "minLength": 1},
          "side_effect": {"type": "string", "minLength": 1},
          "cost_model": {"type": "string", "minLength": 1},
          "cross_model_safe": {"type": "boolean"},
          "authority_level": {"enum": ["L0", "L1", "L2"]},
          "required_model_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "workflows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workflow_id", "workflow_version", "required_plugins"],
        "properties": {
          "workflow_id": {"type": "string", "minLength": 1},
          "workflow_version": {"type": "string", "minLength": 1},
          "required_plugins": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
