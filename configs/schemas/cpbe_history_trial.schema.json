{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["trial_id", "evidence_class", "context", "probe", "outcomes", "evidence_refs"],
  "properties": {
    "trial_id": {"type": "string", "minLength": 1},
    "evidence_class": {"type": "string", "enum": ["synthetic_fixture", "historical_replay", "live"]},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backbone_family", "capability_class", "failure_signature", "primitive"],
      "properties": {
        "backbone_family": {"type": "string", "minLength": 1},
        "capability_class": {"type": "string", "minLength": 1},
        "failure_signature": {"type": "string", "minLength": 1},
        "primitive": {"type": "string", "minLength": 1}
      }
    },
    "probe": {"type": "object"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locality_pass",
        "nonredundant",
        "collision_resolved",
        "regret_reduction",
        "coverage_gain",
        "gpu_hours"
      ],
      "properties": {
        "locality_pass": {"type": "boolean"},
        "nonredundant": {"type": "boolean"},
        "collision_resolved": {"type": "boolean"},
        "regret_reduction": {"type": "number"},
        "coverage_gain": {"type": "number"},
        "gpu_hours": {"type": "number", "exclusiveMinimum": 0.0}
      }
    }
  }
}
