{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["trial_id", "evidence_class", "context", "probe", "outcomes", "evidence_refs"],
  "properties": {
    "trial_id": {"type": "string", "minLength": 1},
    "evidence_class": {"type": "string", "enum": ["synthetic_fixture", "historical_replay", "live"]},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backbone_family", "capability_class", "failure_signature", "primitive"],
      "properties": {
        "backbone_family": {"type": "string", "minLength": 1},
        "capability_class": {"type": "string", "minLength": 1},
        "failure_signature": {"type": "string", "minLength": 1},
        "primitive": {"type": "string", "minLength": 1}
      }
    },
    "probe": {
      "type": "object",
      "required": [
        "probe_id",
        "signal_source",
        "hook_type",
        "spatial_mask",
        "temporal_basis",
        "contrast_operator",
        "dose_schedule",
        "aggregation",
        "invariants",
        "required_capabilities",
        "estimated_gpu_hours",
        "origin",
        "diagnostic_only",
        "reversible"
      ],
      "properties": {
        "probe_id": {"type": "string", "minLength": 1},
        "signal_source": {"type": "string", "minLength": 1},
        "hook_type": {"type": "string", "minLength": 1},
        "spatial_mask": {"type": "string", "minLength": 1},
        "temporal_basis": {"type": "string", "minLength": 1},
        "contrast_operator": {"type": "string", "minLength": 1},
        "dose_schedule": {"type": "array", "minItems": 2, "items": {"type": "number"}},
        "aggregation": {"type": "string", "minLength": 1},
        "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "estimated_gpu_hours": {"type": "number", "exclusiveMinimum": 0.0},
        "origin": {"type": "string", "enum": ["residual", "mutation", "retrieval", "llm"]},
        "parent_probe_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string"},
        "diagnostic_only": {"type": "boolean", "enum": [true]},
        "reversible": {"type": "boolean", "enum": [true]}
      }
    },
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locality_pass",
        "nonredundant",
        "collision_resolved",
        "regret_reduction",
        "coverage_gain",
        "gpu_hours"
      ],
      "properties": {
        "locality_pass": {"type": ["boolean", "null"]},
        "nonredundant": {"type": ["boolean", "null"]},
        "collision_resolved": {"type": ["boolean", "null"]},
        "regret_reduction": {"type": ["number", "null"]},
        "coverage_gain": {"type": ["number", "null"]},
        "gpu_hours": {"type": "number", "exclusiveMinimum": 0.0}
      }
    }
  }
}
