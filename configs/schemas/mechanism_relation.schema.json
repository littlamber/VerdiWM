{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "artifact_type", "relation_id", "source_mechanism_id",
    "target_mechanism_id", "relation_type", "composition_operator",
    "condition_set", "anti_conditions", "baseline_effect", "source_effect",
    "target_effect", "combined_effect", "interaction_effect", "uncertainty",
    "replication_count", "required_ablations", "evidence_refs", "claim_scope",
    "verification_state", "validity_gates", "notes"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "artifact_type": {"const": "verdiwm-mechanism-relation"},
    "relation_id": {"type": "string", "minLength": 1},
    "source_mechanism_id": {"type": "string", "minLength": 1},
    "target_mechanism_id": {"type": "string", "minLength": 1},
    "relation_type": {"enum": ["positive_synergy", "antagonism", "redundancy", "conditional_compatibility", "sequential_dependency", "substitution"]},
    "composition_operator": {"enum": ["parallel", "sequential", "gated", "conditional"]},
    "condition_set": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "anti_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "baseline_effect": {"type": "number"},
    "source_effect": {"type": "number"},
    "target_effect": {"type": "number"},
    "combined_effect": {"type": "number"},
    "interaction_effect": {"type": "number"},
    "uncertainty": {"type": "number", "minimum": 0},
    "replication_count": {"type": "integer", "minimum": 1},
    "required_ablations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(cas://|urn:|sha256:)"}},
    "claim_scope": {"type": "string", "minLength": 1},
    "verification_state": {"enum": ["candidate", "screened", "confirmed", "rejected", "abstained"]},
    "validity_gates": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
