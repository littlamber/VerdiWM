{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "candidate_id",
    "candidate",
    "model_family",
    "stage",
    "settlement_state",
    "verification_state",
    "verdict_ref",
    "contract_id",
    "contract_digest",
    "policy_digest",
    "outcome",
    "promotion_state",
    "source_id",
    "source_digest",
    "assessment_digest",
    "implementation_revision",
    "metric_deltas",
    "blockers",
    "evidence_refs",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-materialized-transfer-evidence"]},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate": {"type": "object"},
    "model_family": {"enum": ["ctrl-world"]},
    "stage": {"enum": ["screen", "confirm"]},
    "settlement_state": {"enum": ["settled"]},
    "verification_state": {"enum": ["verified"]},
    "verdict_ref": {"type": "string", "pattern": "^cas://sha256/[0-9a-f]{64}$"},
    "contract_id": {"type": "string", "minLength": 1},
    "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {"enum": ["confirmed_positive", "rejected_at_screen", "rejected_at_confirm", "operational_failure"]},
    "promotion_state": {"enum": ["verified_target_positive", "verified_negative_boundary", "no_scientific_claim"]},
    "source_id": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assessment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "implementation_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "metric_deltas": {"type": "object"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^cas://sha256/[0-9a-f]{64}$"}
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
