{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "trial_id",
    "state",
    "input_binding",
    "process",
    "gpu",
    "validation",
    "artifacts",
    "actual_gpu_hours",
    "authority",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_type": {
      "const": "verdiwm-wan-arm-slot-inference-receipt"
    },
    "trial_id": {
      "type": "string",
      "pattern": "^wan-arm-slot-[0-9a-f]{24}$"
    },
    "state": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "input_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "selection",
        "config_sha256",
        "selection_sha256",
        "checkpoint_sha256",
        "model_asset_sha256",
        "entrypoint_sha256",
        "source_tree_revision",
        "source_root",
        "checkpoint",
        "data_root",
        "runtime_python",
        "condition_override_root",
        "data_sha256",
        "condition_override_sha256",
        "seed",
        "split",
        "inference_steps",
        "max_chunks",
        "limit",
        "fps",
        "timeout_seconds",
        "output_root"
      ],
      "properties": {
        "config": {
          "$ref": "#/$defs/path"
        },
        "selection": {
          "$ref": "#/$defs/path"
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "checkpoint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entrypoint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_tree_revision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "kind",
            "revision",
            "detail"
          ],
          "properties": {
            "state": {
              "const": "bound"
            },
            "kind": {
              "const": "source_tree_sha256"
            },
            "revision": {
              "$ref": "#/$defs/sha256"
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source_root": {
          "$ref": "#/$defs/path"
        },
        "checkpoint": {
          "$ref": "#/$defs/path"
        },
        "data_root": {
          "$ref": "#/$defs/path"
        },
        "runtime_python": {
          "$ref": "#/$defs/path"
        },
        "condition_override_root": {
          "anyOf": [
            {
              "$ref": "#/$defs/path"
            },
            {
              "type": "null"
            }
          ]
        },
        "data_sha256": {
          "$ref": "#/$defs/file_bindings"
        },
        "condition_override_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/file_bindings"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "split": {
          "enum": [
            "train",
            "val",
            "test"
          ]
        },
        "inference_steps": {
          "type": "integer",
          "minimum": 1
        },
        "max_chunks": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "output_root": {
          "$ref": "#/$defs/path"
        },
        "model_asset_sha256": {
          "$ref": "#/$defs/file_bindings"
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "returncode",
        "error",
        "duration_seconds",
        "command",
        "stdout_sha256",
        "stderr_sha256",
        "isolation",
        "authority"
      ],
      "properties": {
        "state": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "returncode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stderr_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "isolation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend",
            "filesystem_isolation_enforced",
            "network_isolation_enforced",
            "credentials_forwarded",
            "gpu_devices"
          ],
          "properties": {
            "backend": {
              "const": "worktree_process"
            },
            "filesystem_isolation_enforced": {
              "const": false
            },
            "network_isolation_enforced": {
              "const": false
            },
            "credentials_forwarded": {
              "const": false
            },
            "gpu_devices": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "community_projection"
          ],
          "properties": {
            "community_projection": {
              "const": false
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "passed"
              }
            }
          },
          "then": {
            "properties": {
              "returncode": {
                "const": 0
              },
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "uuid",
        "name",
        "lock_path"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "uuid": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "lock_path": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_unchanged",
        "errors"
      ],
      "properties": {
        "input_unchanged": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^cas://sha256/[0-9a-f]{64}$"
      }
    },
    "actual_gpu_hours": {
      "type": "number",
      "minimum": 0
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_only",
        "promotion"
      ],
      "properties": {
        "diagnostic_only": {
          "const": true
        },
        "promotion": {
          "const": false
        }
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 12
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "passed"
          }
        }
      },
      "then": {
        "properties": {
          "process": {
            "properties": {
              "state": {
                "const": "passed"
              }
            }
          },
          "validation": {
            "properties": {
              "input_unchanged": {
                "const": true
              },
              "errors": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "file_bindings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    }
  }
}
