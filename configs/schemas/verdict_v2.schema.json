{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "claim_boundary",
    "replication_statistics",
    "proposal_id",
    "gates",
    "action_following_gate",
    "delta_m_ver",
    "negative_metrics",
    "verdict",
    "violation"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "artifact_type": {
      "const": "wmloop-verdict"
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "gates": {
      "type": "object",
      "required": [
        "G1_readonly",
        "G2_heldout",
        "G3_audit",
        "G4_replication"
      ]
    },
    "action_following_gate": {
      "type": "object",
      "required": [
        "enabled",
        "threshold",
        "observed",
        "pass"
      ]
    },
    "delta_m_ver": {
      "type": "object"
    },
    "negative_metrics": {
      "type": "object"
    },
    "replication_statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidence_interval",
        "sample_count",
        "minimum_sample_count",
        "threshold",
        "replication_seeds",
        "seed_binding",
        "policy",
        "policy_sha256"
      ],
      "properties": {
        "confidence_interval": {
          "const": "student_t_two_sided_95"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_sample_count": {
          "type": "integer",
          "minimum": 3
        },
        "threshold": {
          "type": "number",
          "minimum": 0
        },
        "replication_seeds": {
          "type": [
            "array",
            "null"
          ],
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "seed_binding": {
          "enum": [
            "unverified_compatibility",
            "missing",
            "mismatch",
            "frozen_goal"
          ]
        },
        "policy": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "schema_version",
            "artifact_type",
            "claim_boundary",
            "primary_metric",
            "metric_directions",
            "minimum_effect",
            "seeds_accept",
            "confidence_interval",
            "goal_sha256",
            "action_following_threshold"
          ],
          "properties": {
            "schema_version": {
              "type": "integer",
              "const": 1
            },
            "artifact_type": {
              "const": "wmloop-verification-policy"
            },
            "claim_boundary": {
              "type": "string",
              "minLength": 1
            },
            "primary_metric": {
              "type": "string",
              "minLength": 1
            },
            "metric_directions": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "enum": [
                  "maximize",
                  "minimize"
                ]
              }
            },
            "minimum_effect": {
              "type": "number",
              "minimum": 0
            },
            "seeds_accept": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "minItems": 3
            },
            "confidence_interval": {
              "const": "student_t_two_sided_95"
            },
            "goal_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "action_following_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "policy_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "mean": {
          "type": "number"
        },
        "standard_error": {
          "type": "number",
          "minimum": 0
        },
        "lower_bound": {
          "type": "number"
        },
        "upper_bound": {
          "type": "number"
        }
      }
    },
    "verdict": {
      "enum": [
        "ACCEPT",
        "REJECT",
        "INCONCLUSIVE",
        "VOID"
      ]
    },
    "violation": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
