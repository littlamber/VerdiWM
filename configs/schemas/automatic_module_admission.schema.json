{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "state", "candidate_id", "idea_id", "abi_id", "embodiment_class", "spec_digest", "input_digest", "model_capability_ir_sha256", "abi_registry_digest", "llm_task_receipt_path", "llm_task_receipt_sha256", "bundle_path", "bundle_sha256", "materialization_plan_path", "materialization_plan_sha256", "evaluator_path", "evaluator_sha256", "side_effects", "claim_boundary"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-automatic-module-admission"]},
    "state": {"enum": ["admitted_for_materialization"]},
    "candidate_id": {"type": "string", "minLength": 1},
    "idea_id": {"type": "string", "minLength": 1},
    "abi_id": {"type": "string", "minLength": 1},
    "embodiment_class": {"enum": ["source_faithful", "derived_embodiment"]},
    "spec_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_capability_ir_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "abi_registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "llm_task_receipt_path": {"type": "string", "minLength": 1},
    "llm_task_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bundle_path": {"type": "string", "minLength": 1},
    "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "materialization_plan_path": {"type": "string", "minLength": 1},
    "materialization_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluator_path": {"type": "string", "minLength": 1},
    "evaluator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manufacturing_mode": {"enum": ["intervention"]},
    "manufacturing_work_order_id": {"type": "string", "pattern": "^module-manufacturing-[0-9a-f]{24}$"},
    "manufacturing_work_order_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manufacturing_work_order_path": {"type": "string", "minLength": 1},
    "manufacturing_work_order_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manufacturing_bindings": {"type": "object"},
    "manufacturing_request": {"type": "object"},
    "dependency_closure": {"type": "object"},
    "portfolio_entry_ids": {"type": "array", "items": {"type": "string", "pattern": "^portfolio-entry-[0-9a-f]{24}$"}},
    "evaluator_binding": {"type": "object"},
    "protected_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "side_effects": {"type": "object"},
    "claim_boundary": {"type": "string", "minLength": 12}
  }
}
