{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "authority",
    "fresh_request",
    "source_state",
    "effective_query",
    "query_plan_sha256",
    "attempts",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_type": {
      "const": "verdiwm-literature-search-trace"
    },
    "authority": {
      "const": "ranking_only"
    },
    "fresh_request": {
      "const": true
    },
    "source_state": {
      "enum": [
        "network",
        "cached",
        "offline"
      ]
    },
    "effective_query": {
      "type": "string",
      "maxLength": 4096
    },
    "query_plan_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "view",
          "query",
          "search_expression",
          "url",
          "fresh_request",
          "source_state",
          "error_code",
          "http_status",
          "response_bytes",
          "response_sha256",
          "record_count",
          "started_at",
          "completed_at"
        ],
        "properties": {
          "view": {
            "type": "string"
          },
          "query": {
            "type": "string",
            "maxLength": 4096
          },
          "search_expression": {
            "type": "string",
            "maxLength": 4096
          },
          "url": {
            "type": "string",
            "maxLength": 16384
          },
          "fresh_request": {
            "const": true
          },
          "source_state": {
            "enum": [
              "network",
              "cached",
              "offline"
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "http_status": {
            "type": [
              "integer",
              "null"
            ]
          },
          "response_bytes": {
            "type": [
              "integer",
              "null"
            ]
          },
          "response_sha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "record_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50
          },
          "started_at": {
            "type": "string",
            "minLength": 1
          },
          "completed_at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
