{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "state",
    "candidate_id",
    "work_order_id",
    "work_order_digest",
    "plan_id",
    "plan_digest",
    "observation_task_id",
    "abi_id",
    "probe_coverage_key",
    "llm_task_receipt_sha256",
    "candidate_sha256",
    "module_source_sha256",
    "conformance_checks",
    "negative_checks",
    "blockers",
    "evidence_refs",
    "authority",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-shadow-probe-admission-receipt"]},
    "state": {"enum": ["admitted_for_shadow_execution", "blocked"]},
    "candidate_id": {"type": ["string", "null"], "pattern": "^shadow-probe-[0-9a-f]{24}$"},
    "work_order_id": {"type": "string", "pattern": "^module-manufacturing-[0-9a-f]{24}$"},
    "work_order_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_id": {"type": "string", "pattern": "^adaptive-probe-plan-[0-9a-f]{24}$"},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observation_task_id": {"type": "string", "pattern": "^observation-task-[0-9a-f]{24}$"},
    "abi_id": {"type": "string", "minLength": 1},
    "probe_coverage_key": {"type": "string", "pattern": "^probe-coverage-[0-9a-f]{24}$"},
    "llm_task_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "module_source_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "conformance_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "passed"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"}
        }
      }
    },
    "negative_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "passed"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"}
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "detail": {"type": "string"}
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^(cas://|urn:|sha256:)"}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shadow_execution",
        "active_portrait_coverage",
        "source_mutation",
        "gpu_scheduling",
        "metric_selection",
        "evaluator_selection",
        "verdict_exposure",
        "promotion"
      ],
      "properties": {
        "shadow_execution": {"type": "boolean"},
        "active_portrait_coverage": {"enum": [false]},
        "source_mutation": {"enum": [false]},
        "gpu_scheduling": {"enum": [false]},
        "metric_selection": {"enum": [false]},
        "evaluator_selection": {"enum": [false]},
        "verdict_exposure": {"enum": [false]},
        "promotion": {"enum": [false]}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 12}
  }
}
