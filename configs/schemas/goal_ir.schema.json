{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "goal_ir_id", "goal_id", "goal_binding", "model_family", "objective", "requirements"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-goal-ir"]},
    "goal_ir_id": {"type": "string", "pattern": "^goal-ir-[0-9a-f]{24}$"},
    "goal_id": {"type": "string", "minLength": 1},
    "goal_binding": {"type": "string", "pattern": "^(cas://|urn:|sha256:)"},
    "model_family": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "capability",
          "kind",
          "dependencies",
          "required_model_capabilities",
          "required_hooks",
          "required_interfaces",
          "required_probe_keys",
          "required_data_regimes",
          "compatible_model_families",
          "manufacturable",
          "external_ports",
          "source"
        ],
        "properties": {
          "requirement_id": {"type": "string", "pattern": "^requirement-[0-9a-f]{24}$"},
          "capability": {"type": "string", "minLength": 1},
          "kind": {"enum": ["observation", "interface", "data", "intervention", "evaluation", "evidence"]},
          "dependencies": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "required_model_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "required_hooks": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "required_interfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "contract_id"],
              "properties": {
                "kind": {"type": "string", "minLength": 1},
                "contract_id": {"type": "string", "minLength": 1}
              }
            }
          },
          "required_probe_keys": {"type": "array", "items": {"type": "string", "pattern": "^probe-coverage-[0-9a-f]{24}$"}},
          "required_data_regimes": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "compatible_model_families": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "manufacturable": {"type": "boolean"},
          "external_ports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["port", "contract"],
              "properties": {
                "port": {"type": "string", "minLength": 1},
                "contract": {"type": "string", "minLength": 1}
              }
            }
          },
          "source": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
