{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "claim_boundary", "primary_metric",
    "direction", "minimum_effect_db", "minimum_paired_seeds",
    "confidence_interval", "threshold_rule", "dataset_sha256",
    "support_sha256", "evaluator_digest", "validation_sample_ids",
    "seed_cohort", "rollout_settings_sha256", "decode_settings_sha256",
    "cohort_sha256", "report_only_metrics"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "verdiwm-agibot-psnr-frozen-goal"},
    "claim_boundary": {"type": "string", "minLength": 32},
    "primary_metric": {"const": "psnr_db"},
    "direction": {"const": "maximize"},
    "minimum_effect_db": {"const": 2.0},
    "minimum_paired_seeds": {"const": 3},
    "confidence_interval": {"const": "student_t_two_sided_95"},
    "threshold_rule": {"const": "lower_bound_db > minimum_effect_db"},
    "dataset_sha256": {"$ref": "#/$defs/hash"},
    "support_sha256": {"$ref": "#/$defs/hash"},
    "evaluator_digest": {"$ref": "#/$defs/hash"},
    "validation_sample_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "seed_cohort": {
      "type": "array", "minItems": 3, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}
    },
    "rollout_settings_sha256": {"$ref": "#/$defs/hash"},
    "decode_settings_sha256": {"$ref": "#/$defs/hash"},
    "cohort_sha256": {"$ref": "#/$defs/hash"},
    "report_only_metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["ssim", "lpips"],
      "properties": {"ssim": {"const": "report_only"}, "lpips": {"const": "not_measured"}}
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
