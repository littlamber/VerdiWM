{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "profile_id",
    "aliases",
    "model_family",
    "capability_level",
    "execution_kind",
    "repo_markers",
    "goal_keywords",
    "evaluator_contract",
    "constitution_freeze",
    "runtime_candidates",
    "asset_bindings",
    "runner",
    "probe_imports"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "artifact_type": {"enum": ["verdiwm-adapter-profile"]},
    "profile_id": {"type": "string", "minLength": 1},
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "model_family": {"type": "string", "minLength": 1},
    "capability_level": {"enum": ["L0", "L1", "L2", "L3"]},
    "execution_kind": {"enum": ["pipeline"]},
    "repo_markers": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "goal_keywords": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "evaluator_contract": {"type": "string", "minLength": 1},
    "probe_contract": {"type": ["string", "null"]},
    "candidate_catalog": {"type": ["string", "null"]},
    "settlement_manifest_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "constitution_freeze": {"type": "string", "minLength": 1},
    "runtime_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "asset_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameter", "candidates"],
        "properties": {
          "parameter": {
            "type": "string",
            "pattern": "^--[A-Za-z0-9_-]+$"
          },
          "candidates": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "requires_training", "train", "evaluate", "checkpoint_receipt", "evaluation_receipt", "adapter_id"],
      "properties": {
        "protocol_version": {"enum": [1]},
        "requires_training": {"const": true},
        "train": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evaluate": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "checkpoint_receipt": {"type": "string", "minLength": 1},
        "evaluation_receipt": {"type": "string", "minLength": 1}
        ,"adapter_id": {"type": "string", "minLength": 1}
      }
    },
    "probe_imports": {"type": "boolean"}
  }
}
