{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "source_id", "source_digest", "source_title", "profile_id", "source_role", "track", "transfer_mode", "execution_state", "failure_context", "source_evidence", "preserved_components", "required_target_capabilities", "missing_target_capabilities", "target_intervention", "forbidden_substitutions", "falsification_criterion", "claim_boundary", "assessment_digest"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [2]},
    "artifact_type": {"enum": ["verdiwm-acwm-source-transfer-assessment"]},
    "source_id": {"type": "string", "minLength": 1},
    "source_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_title": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "source_role": {"enum": ["transferable_optimizer", "diagnostic_method", "research_substrate", "incompatible"]},
    "track": {"type": "string", "minLength": 1},
    "transfer_mode": {"enum": ["mechanism_transfer", "diagnostic_only", "substrate_only", "none"]},
    "execution_state": {"enum": ["materialization_required", "blocked_target_capability", "diagnostic_routing_required", "knowledge_only", "rejected_source_target_mismatch", "rejected_source_mechanism_ungrounded"]},
    "failure_context": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_evidence": {"type": "array", "items": {"type": "object"}},
    "preserved_components": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "required_target_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "missing_target_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "target_intervention": {"type": "string", "minLength": 1},
    "forbidden_substitutions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
    "falsification_criterion": {"type": "string", "minLength": 12},
    "claim_boundary": {"type": "string", "minLength": 12},
    "assessment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
