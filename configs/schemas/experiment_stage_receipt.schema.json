{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "experiment_id",
    "fold_id",
    "trial_id",
    "target_backbone",
    "scenario",
    "arm",
    "selector",
    "seed",
    "stage",
    "settlement_state",
    "outcome",
    "certificate_status",
    "metric_name",
    "baseline_value",
    "candidate_value",
    "delta",
    "threshold",
    "gpu_hours",
    "sequence_index",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "artifact_type": {"enum": ["verdiwm-experiment-stage-receipt"]},
    "experiment_id": {"type": "string", "minLength": 1},
    "fold_id": {"type": "string", "minLength": 1},
    "trial_id": {"type": "string", "minLength": 1},
    "target_backbone": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "arm": {"enum": ["warm_start", "cold_start", "random_search"]},
    "selector": {"enum": ["environment_label", "static_probe", "raw_response", "irg", "none"]},
    "seed": {"type": "integer"},
    "stage": {"enum": ["screen", "gate", "confirm"]},
    "settlement_state": {"enum": ["queued", "running", "failed", "settled"]},
    "outcome": {"enum": ["positive", "negative", "abstain", "inconclusive", "void"]},
    "certificate_status": {"enum": ["licensed", "abstain", "not_applicable"]},
    "metric_name": {"type": "string", "minLength": 1},
    "baseline_value": {"type": "number"},
    "candidate_value": {"type": "number"},
    "delta": {"type": "number"},
    "threshold": {"type": "number", "minimum": 0},
    "gpu_hours": {"type": "number", "minimum": 0},
    "sequence_index": {"type": "integer", "minimum": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
