{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "instance_id",
    "backbone_family",
    "goal_id",
    "campaign_state",
    "claim_scope",
    "surfaces",
    "invariants",
    "next_actions"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "artifact_type": {"enum": ["wmloop-backbone-instance"]},
    "instance_id": {"type": "string", "minLength": 1},
    "backbone_family": {"enum": ["acwm_phys", "ctrl_world", "cosmos3", "wam", "generic"]},
    "goal_id": {"type": "string", "minLength": 1},
    "campaign_state": {"enum": ["active_ready", "pilot_draft", "blocked"]},
    "claim_scope": {"type": "string", "minLength": 1},
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface_id",
          "role",
          "status",
          "artifact_ref",
          "required_for_closed_loop",
          "required_for_formal_verdict",
          "notes"
        ],
        "properties": {
          "surface_id": {"type": "string", "minLength": 1},
          "role": {"enum": ["constitutional", "adapter", "signal", "archive", "runtime"]},
          "status": {"enum": ["ready", "external_ready", "draft", "missing", "blocked"]},
          "artifact_ref": {"type": "string", "minLength": 1},
          "required_for_closed_loop": {"type": "boolean"},
          "required_for_formal_verdict": {"type": "boolean"},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "next_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
