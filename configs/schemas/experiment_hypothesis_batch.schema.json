{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "candidates"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-experiment-hypothesis-batch"]},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mechanism_contract",
          "expected_portrait_changes",
          "structural_conditions",
          "behavioral_conditions",
          "discriminates_from",
          "required_module_capabilities",
          "information_gain",
          "uncertainty",
          "estimated_screen_gpu_hours",
          "selection_reason"
        ],
        "properties": {
          "mechanism_contract": {"type": "object"},
          "expected_portrait_changes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "structural_conditions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "behavioral_conditions": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "discriminates_from": {
            "type": "array",
            "items": {"type": "string", "pattern": "^mechanism-[0-9a-f]{24}$"}
          },
          "required_module_capabilities": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "information_gain": {"type": "number", "minimum": 0, "maximum": 1},
          "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
          "estimated_screen_gpu_hours": {"type": "number", "exclusiveMinimum": 0},
          "selection_reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
