{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "probe_id",
    "stage",
    "passed",
    "metrics",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"type": "string", "enum": ["verdiwm-cpbe-stage-receipt"]},
    "probe_id": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "enum": ["static", "offline", "canary", "expanded"]},
    "passed": {"type": "boolean"},
    "metrics": {"type": "object"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
