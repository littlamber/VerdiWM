{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "hypothesis_id", "target_failure", "causal_assumption", "target_touchpoint", "predicted_observation", "falsification_test", "required_capabilities", "anti_conditions", "source_evidence", "novelty_status", "claim_boundary"],
  "properties": {
    "schema_version": {"const": 1}, "artifact_type": {"const": "verdiwm-mechanism-hypothesis"}, "hypothesis_id": {"type": "string", "pattern": "^mechanism-hypothesis-[0-9a-f]{24}$"},
    "target_failure": {"type": "string", "minLength": 12}, "causal_assumption": {"type": "string", "minLength": 12}, "target_touchpoint": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "predicted_observation": {"type": "string", "minLength": 12}, "falsification_test": {"type": "string", "minLength": 12}, "required_capabilities": {"type": "array", "items": {"type": "string"}}, "anti_conditions": {"type": "array", "items": {"type": "string"}},
    "source_evidence": {"type": "array", "items": {"type": "string"}}, "novelty_status": {"enum": ["known_reproduction", "target_adaptation", "composition", "mechanism_modification", "unexplored_hypothesis", "novelty_unresolved"]}, "claim_boundary": {"type": "string", "minLength": 12}
  }
}
