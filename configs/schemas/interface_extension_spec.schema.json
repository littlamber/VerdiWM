{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "extension_id",
    "requested_surface",
    "semantic_role",
    "typed_inputs",
    "typed_outputs",
    "side_effect_class",
    "authority_level",
    "conformance_tests",
    "negative_tests",
    "source_mutation_allowed",
    "active_metric_mutation_allowed",
    "active_evaluator_mutation_allowed",
    "execution_state",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-interface-extension-spec"]},
    "extension_id": {"type": "string", "pattern": "^interface-extension-[0-9a-f]{24}$"},
    "requested_surface": {"type": "string", "minLength": 1},
    "semantic_role": {"type": "string", "minLength": 1},
    "typed_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "contract"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "contract": {"type": "string", "minLength": 1}
        }
      }
    },
    "typed_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "contract"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "contract": {"type": "string", "minLength": 1}
        }
      }
    },
    "side_effect_class": {"enum": ["read_only_observation_hook"]},
    "authority_level": {"enum": ["L1"]},
    "conformance_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "negative_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_mutation_allowed": {"enum": [false]},
    "active_metric_mutation_allowed": {"enum": [false]},
    "active_evaluator_mutation_allowed": {"enum": [false]},
    "execution_state": {"enum": ["proposed"]},
    "claim_boundary": {"type": "string", "minLength": 12}
  }
}
