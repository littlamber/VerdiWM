{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "policy_id", "policy_digest", "contract_id", "contract_digest", "target_model_family", "target_capabilities", "queries", "source_policy", "idea_policy", "execution_policy", "mechanism_profiles"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [2]},
    "artifact_type": {"enum": ["verdiwm-acwm-research-intake"]},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_id": {"type": "string", "minLength": 1},
    "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_model_family": {"type": "string", "minLength": 1},
    "target_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "queries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "max_results_per_source", "timeout_seconds", "response_byte_limit"],
      "properties": {
        "sources": {"type": "array", "minItems": 1, "items": {"enum": ["arxiv", "github", "openalex"]}},
        "max_results_per_source": {"type": "integer", "minimum": 1, "maximum": 20},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
        "response_byte_limit": {"type": "integer", "minimum": 1024, "maximum": 2000000},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 5},
        "retry_backoff_seconds": {"type": "number", "minimum": 0, "maximum": 10}
      }
    },
    "idea_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_ideas", "min_external_sources"],
      "properties": {
        "max_ideas": {"type": "integer", "minimum": 1, "maximum": 32},
        "min_external_sources": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_stages", "source_code_mutation", "promotion_authority"],
      "properties": {
        "required_stages": {"type": "array", "minItems": 3, "items": {"enum": ["screen", "confirm", "frozen_verifier"]}},
        "source_code_mutation": {"enum": ["materialization_required"]},
        "promotion_authority": {"enum": ["frozen_verifier_only"]}
      }
    },
    "mechanism_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "priority", "source_role", "track", "transfer_mode", "required_term_groups", "excluded_terms", "components", "required_capabilities", "target_intervention", "forbidden_substitutions", "falsification_criterion"],
        "properties": {
          "profile_id": {"type": "string", "minLength": 1},
          "priority": {"type": "integer", "minimum": 1},
          "source_role": {"enum": ["transferable_optimizer", "diagnostic_method", "research_substrate", "incompatible"]},
          "track": {"type": "string", "minLength": 1},
          "transfer_mode": {"enum": ["mechanism_transfer", "diagnostic_only", "substrate_only", "none"]},
          "required_term_groups": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
          "excluded_terms": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "components": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["component_id", "description", "evidence_terms"],
              "properties": {
                "component_id": {"type": "string", "minLength": 1},
                "description": {"type": "string", "minLength": 12},
                "evidence_terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}}
              }
            }
          },
          "required_capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "target_intervention": {"type": "string", "minLength": 4},
          "forbidden_substitutions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
          "falsification_criterion": {"type": "string", "minLength": 12}
        }
      }
    }
  }
}
