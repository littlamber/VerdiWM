{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "evidence_id", "context", "intervention", "outcome", "validity_region", "evidence_refs", "status", "authority"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-evidence-ir"]},
    "evidence_id": {"type": "string", "minLength": 1},
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_family", "capability_class", "goal_protocol", "outcome_protocol", "data_regime", "horizons"],
      "properties": {
        "model_family": {"type": "string", "minLength": 1},
        "capability_class": {"type": "string", "minLength": 1},
        "goal_protocol": {"type": "string", "minLength": 1},
        "outcome_protocol": {"type": "string", "minLength": 1},
        "data_regime": {"type": "string", "minLength": 1},
        "horizons": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive_id", "semantic_intent", "target_hooks"],
      "properties": {
        "primitive_id": {"type": "string", "minLength": 1},
        "semantic_intent": {"type": "string", "minLength": 1},
        "target_hooks": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "mean", "standard_error", "lower_bound", "threshold", "replication_count"],
      "properties": {
        "label": {"enum": ["positive", "null", "harmful", "interaction"]},
        "mean": {"type": "number"},
        "standard_error": {"type": "number", "minimum": 0},
        "lower_bound": {"type": "number"},
        "threshold": {"type": "number"},
        "replication_count": {"type": "integer", "minimum": 1}
      }
    },
    "validity_region": {"type": "object"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(cas://|urn:|sha256:)"}},
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {"enum": ["schema_valid", "shadow", "target_confirmed", "transfer_licensed", "community_promoted", "revoked", "deprecated"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_binding", "evaluator_binding", "promotion_policy", "claim_scope"],
      "properties": {
        "goal_binding": {"type": ["string", "null"]},
        "evaluator_binding": {"type": ["string", "null"]},
        "promotion_policy": {"enum": ["verifier_only"]},
        "claim_scope": {"enum": ["ranking_only", "target_local", "transfer_prior", "community"]}
      }
    }
  }
}
