{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "model_run_id", "campaign_id", "manifest_path", "adapter", "runner", "source", "runtime", "training", "evaluation", "resource_binding", "output", "isolation", "claim_boundary"],
  "properties": {
    "schema_version": {"enum": [1]},
    "artifact_type": {"enum": ["verdiwm-model-run-manifest"]},
    "model_run_id": {"type": "string", "pattern": "^model-run-[0-9a-f]{24}$"},
    "campaign_id": {"type": "string", "minLength": 1},
    "manifest_path": {"type": "string", "minLength": 1},
    "adapter": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "model_family", "capability_level", "protocol_version"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "model_family": {"type": "string", "minLength": 1},
        "capability_level": {"const": "L2"},
        "protocol_version": {"enum": [1, 2, 3]}
      }
    },
    "runner": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter_id"],
      "properties": {"adapter_id": {"type": ["string", "null"]}}
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["model_root", "dataset_root", "source_root", "asset_bindings"],
      "properties": {
        "model_root": {"type": "string", "minLength": 1},
        "dataset_root": {"type": "string", "minLength": 1},
        "source_root": {"type": "string", "minLength": 1},
        "adapter_root": {"type": "string", "minLength": 1},
        "asset_bindings": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["python", "train_command"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "train_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "training": {
      "type": "object", "additionalProperties": false,
      "required": ["scale_plan", "scale_plan_digest", "checkpoint_receipt"],
      "properties": {
        "scale_plan": {"type": "object"},
        "scale_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checkpoint_receipt": {"type": "string", "minLength": 1},
        "agibot_training_support": {"type": "object"},
        "agibot_receipt_bindings": {"type": "object"},
        "agibot_native_config": {"$ref": "#/$defs/agibotNativeConfig"}
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluator_contract", "command", "evidence_receipt"],
      "properties": {
        "evaluator_contract": {"type": "string", "minLength": 1},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_receipt": {"type": "string", "minLength": 1},
        "stage": {"enum": ["heldout_evaluation", "engineering_diagnostic"]},
        "evidence_class": {"enum": ["runtime_only", "diagnostic", "formal"]},
        "quality_eligible": {"type": "boolean"}
      }
    },
    "resource_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["allocation", "role", "gpu_lease_required"],
      "properties": {
        "allocation": {"type": "object"},
        "role": {"type": "string", "minLength": 1},
        "gpu_lease_required": {"const": true}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "checkpoint_receipt", "evidence_receipt"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "checkpoint_receipt": {"type": "string", "minLength": 1},
        "evidence_receipt": {"type": "string", "minLength": 1}
      }
    },
    "isolation": {
      "type": "object", "additionalProperties": false,
      "required": ["model_source_read_only", "dataset_read_only", "evaluator_read_only", "output_root_fresh"],
      "properties": {
        "model_source_read_only": {"const": true},
        "dataset_read_only": {"const": true},
        "evaluator_read_only": {"const": true},
        "output_root_fresh": {"const": true},
        "network_access": {"const": false},
        "network_required": {"const": false},
        "network_policy": {"const": "known_clients_offline_only"},
        "os_sandbox_enforced": {"const": false}
      }
    },
    "execution_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["stage_timeout_seconds", "timeout_receipt"],
      "properties": {
        "stage_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "stage_timeouts_seconds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["train", "engineering_diagnostic"],
          "properties": {
            "train": {"type": "number", "exclusiveMinimum": 0},
            "engineering_diagnostic": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "timeout_receipt": {"type": "string", "minLength": 1}
      }
    },
    "budget_binding": {"$ref": "#/$defs/budgetBinding"},
    "claim_boundary": {"type": "string", "minLength": 12}
  },
  "$defs": {
    "agibotNativeConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "source_sha256", "path", "sha256", "base_model_path", "init_from_path", "vae_checkpoint_path", "world_model_action_num_domains", "wm_training_action_num_domains"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "base_model_path": {"type": "string", "minLength": 1},
        "init_from_path": {"type": "string", "minLength": 1},
        "vae_checkpoint_path": {"type": "string", "minLength": 1},
        "world_model_action_num_domains": {"type": "integer", "minimum": 1},
        "wm_training_action_num_domains": {"type": "integer", "minimum": 1}
      }
    },
    "budgetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledger_path", "cas_root", "policy", "estimated_gpu_hours", "cost_class", "human_approved", "trial_id", "plan_sha256"],
      "properties": {
        "ledger_path": {"type": "string", "minLength": 1},
        "cas_root": {"type": "string", "minLength": 1},
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total_gpu_hours", "high_trial_limit", "max_trial_gpu_hours", "require_high_cost_approval"],
          "properties": {
            "total_gpu_hours": {"type": "number", "exclusiveMinimum": 0},
            "high_trial_limit": {"type": "integer", "minimum": 0},
            "max_trial_gpu_hours": {"type": "number", "exclusiveMinimum": 0},
            "require_high_cost_approval": {"type": "boolean"}
          }
        },
        "estimated_gpu_hours": {"type": "number", "exclusiveMinimum": 0},
        "cost_class": {"enum": ["very_low", "low", "medium", "high"]},
        "human_approved": {"type": "boolean"},
        "trial_id": {"type": "string", "pattern": "^model-run-trial-[0-9a-f]{24}$"},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"adapter": {"properties": {"protocol_version": {"const": 3}}}},
        "required": ["adapter"]
      },
      "then": {
        "properties": {
          "training": {"required": ["agibot_training_support", "agibot_receipt_bindings", "agibot_native_config"]},
          "budget_binding": {"$ref": "#/$defs/budgetBinding"},
          "execution_policy": {"required": ["stage_timeouts_seconds"]},
          "evaluation": {
            "required": ["stage", "evidence_class", "quality_eligible"],
            "properties": {
              "stage": {"const": "engineering_diagnostic"},
              "evidence_class": {"const": "runtime_only"},
              "quality_eligible": {"const": false}
            }
          },
          "isolation": {
            "required": ["network_required", "network_policy", "os_sandbox_enforced"],
            "not": {"required": ["network_access"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"adapter": {"properties": {"protocol_version": {"enum": [1, 2]}}}},
        "required": ["adapter"]
      },
      "then": {"properties": {"isolation": {"required": ["network_access"]}}}
    }
  ]
}
