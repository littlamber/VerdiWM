{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "state",
    "candidate_id",
    "idea_id",
    "plan_id",
    "plan_digest",
    "input_sha256",
    "source_revision",
    "source_status_sha256",
    "snapshot_revision",
    "implementation_revision",
    "worktree_diff_sha256",
    "changed_paths",
    "required_check_labels",
    "command_receipts",
    "descriptor_sha256",
    "blockers",
    "evidence_refs",
    "side_effects",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-automatic-materialization-receipt"]},
    "state": {"enum": ["ready_for_candidate_compilation", "blocked"]},
    "candidate_id": {"type": "string", "minLength": 1},
    "idea_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_status_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "implementation_revision": {"type": ["string", "null"]},
    "worktree_diff_sha256": {"type": ["string", "null"]},
    "changed_paths": {"type": "array", "items": {"type": "string"}},
    "required_check_labels": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "command_receipts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "descriptor_sha256": {"type": ["string", "null"]},
    "blockers": {"type": "array", "items": {"type": "object"}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^cas://sha256/[0-9a-f]{64}$"}},
    "manufacturing_mode": {"enum": ["intervention"]},
    "manufacturing_work_order_id": {"type": "string", "pattern": "^module-manufacturing-[0-9a-f]{24}$"},
    "manufacturing_work_order_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manufacturing_request_id": {"type": "string", "minLength": 1},
    "manufacturing_abi_id": {"type": "string", "minLength": 1},
    "portfolio_entry_ids": {"type": "array", "items": {"type": "string", "pattern": "^portfolio-entry-[0-9a-f]{24}$"}},
    "protected_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "side_effects": {"type": "object"},
    "claim_boundary": {"type": "string", "minLength": 12}
  }
}
