{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "state",
    "phase",
    "receipt_id",
    "receipt_digest",
    "work_id",
    "bindings",
    "role_partition",
    "portfolio_trials",
    "allocation",
    "reallocation_policy",
    "authority",
    "artifact_policy",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-resource-portfolio-receipt"]},
    "state": {"enum": ["ready_for_screen", "ready_for_confirm"]},
    "phase": {"enum": ["screen_admission", "confirm_reallocation"]},
    "receipt_id": {"type": "string", "pattern": "^resource-portfolio-[0-9a-f]{24}$"},
    "receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "work_id": {"type": "string", "minLength": 1},
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_digest",
        "portfolio_id",
        "portfolio_digest",
        "candidate_id",
        "parent_receipt_id",
        "parent_receipt_digest",
        "screen_evidence_digest",
        "training_scale_plan_digest"
      ],
      "properties": {
        "config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "portfolio_id": {"type": "string", "pattern": "^experiment-portfolio-[0-9a-f]{24}$"},
        "portfolio_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "candidate_id": {"type": "string", "minLength": 1},
        "parent_receipt_id": {"type": ["string", "null"], "pattern": "^resource-portfolio-[0-9a-f]{24}$"},
        "parent_receipt_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "screen_evidence_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "training_scale_plan_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "role_partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allocation_id", "inventory_gpu_indices", "experiment", "data_preparation"],
      "properties": {
        "allocation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inventory_gpu_indices": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "experiment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "gpu_indices",
            "per_job_gpus",
            "max_parallel_jobs",
            "work_policy",
            "scale_plan_digest"
          ],
          "properties": {
            "role": {"type": "string", "minLength": 1},
            "gpu_indices": {
              "type": "array",
              "items": {"type": "integer", "minimum": 0}
            },
            "per_job_gpus": {"type": "integer", "minimum": 1},
            "max_parallel_jobs": {"type": "integer", "minimum": 0},
            "work_policy": {"type": "string", "minLength": 1},
            "scale_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "data_preparation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "gpu_indices",
            "per_job_gpus",
            "max_parallel_jobs",
            "work_policy",
            "workload_id",
            "scale_plan_digest"
          ],
          "properties": {
            "role": {"type": "string", "minLength": 1},
            "gpu_indices": {
              "type": "array",
              "items": {"type": "integer", "minimum": 0}
            },
            "per_job_gpus": {"type": "integer", "minimum": 1},
            "max_parallel_jobs": {"type": "integer", "minimum": 0},
            "work_policy": {"type": "string", "minLength": 1},
            "workload_id": {"type": "string", "minLength": 1},
            "scale_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "portfolio_trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trial_id",
          "entry_id",
          "candidate_id",
          "mechanism_id",
          "role",
          "replication_index",
          "seed",
          "stage",
          "state",
          "estimated_gpu_hours",
          "dependencies"
        ],
        "properties": {
          "trial_id": {"type": "string", "pattern": "^resource-trial-[0-9a-f]{24}$"},
          "entry_id": {"type": "string", "pattern": "^portfolio-entry-[0-9a-f]{24}$"},
          "candidate_id": {"type": ["string", "null"]},
          "mechanism_id": {"type": ["string", "null"]},
          "role": {"enum": ["baseline", "mechanism_test", "negative_control", "ablation"]},
          "replication_index": {"type": "integer", "minimum": 0},
          "seed": {"type": "integer", "minimum": 0},
          "stage": {"enum": ["screen", "confirm"]},
          "state": {"enum": ["admitted", "conditional", "not_selected"]},
          "estimated_gpu_hours": {"type": "number", "minimum": 0},
          "dependencies": {
            "type": "array",
            "items": {"type": "string", "pattern": "^portfolio-entry-[0-9a-f]{24}$"}
          }
        }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_trial_id",
        "stage",
        "allowed_gpu_indices",
        "requested_gpu_count",
        "max_parallel_jobs",
        "distributed_training",
        "scale_rationale"
      ],
      "properties": {
        "selected_trial_id": {"type": "string", "pattern": "^resource-trial-[0-9a-f]{24}$"},
        "stage": {"enum": ["screen", "confirm"]},
        "allowed_gpu_indices": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 0}
        },
        "requested_gpu_count": {"type": "integer", "minimum": 1, "maximum": 6},
        "max_parallel_jobs": {"type": "integer", "minimum": 1, "maximum": 6},
        "distributed_training": {"type": "boolean"},
        "scale_rationale": {"type": ["object", "null"]}
      }
    },
    "reallocation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "screens_before_confirms",
        "require_screen_acceptance",
        "distributed_requires_ready_scale_plan",
        "distributed_requires_information_gain_rationale"
      ],
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "screens_before_confirms": {"enum": [true]},
        "require_screen_acceptance": {"enum": [true]},
        "distributed_requires_ready_scale_plan": {"enum": [true]},
        "distributed_requires_information_gain_rationale": {"enum": [true]}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_lease_request", "evaluator_mutation", "metric_mutation", "promotion"],
      "properties": {
        "gpu_lease_request": {"enum": [true]},
        "evaluator_mutation": {"enum": [false]},
        "metric_mutation": {"enum": [false]},
        "promotion": {"enum": [false]}
      }
    },
    "artifact_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_policy", "cleanup_policy", "retain_failed_terminal_evidence"],
      "properties": {
        "archive_policy": {"enum": ["archive_all_terminal"]},
        "cleanup_policy": {"enum": ["after_content_addressed_receipt"]},
        "retain_failed_terminal_evidence": {"enum": [true]}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
