{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "state", "proposal", "workflow", "engineering", "training", "execution", "claim_boundary"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "artifact_type": {"enum": ["verdiwm-compiled-experiment-manifest"]},
    "state": {"enum": ["ready", "blocked"]},
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "version", "sha256"],
      "properties": {
        "proposal_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_id", "workflow_version", "skills", "capability_digest", "registry_id", "registry_digest", "registry_path", "registry_sha256"],
      "properties": {
        "workflow_id": {"type": "string", "minLength": 1},
        "workflow_version": {"type": "string", "minLength": 1},
        "skills": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "capability_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "registry_id": {"type": "string", "minLength": 1},
        "registry_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "registry_path": {"type": "string", "minLength": 1},
        "registry_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "model_capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "semantic_digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "semantic_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "experiment_ir": {"type": "object"},
    "experiment_ir_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "engineering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_path", "manifest_sha256", "lint_state", "source_revision", "source_dirty"],
      "properties": {
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "lint_state": {"enum": ["ready", "blocked"]},
        "source_revision": {"type": ["string", "null"]},
        "source_dirty": {"type": "boolean"}
      }
    },
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_path", "plan_sha256", "plan_state", "stage", "recipe", "blockers"],
      "properties": {
        "plan_path": {"type": "string", "minLength": 1},
        "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "plan_state": {"enum": ["ready", "blocked"]},
        "stage": {"type": "string", "minLength": 1},
        "recipe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "status", "planner_policy"],
          "properties": {
            "id": {"type": ["string", "null"]},
            "status": {"type": ["string", "null"]},
            "planner_policy": {"type": ["string", "null"]}
          }
        },
        "blockers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launch_state", "requires", "authority", "blockers"],
      "properties": {
        "launch_state": {"enum": ["not_started"]},
        "requires": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "authority": {"type": "object", "additionalProperties": true},
        "blockers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
