{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "audit_id", "inputs", "thresholds", "next_work"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "artifact_type": {"enum": ["verdiwm-system-utility-audit"]},
    "audit_id": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "artifact_type"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "artifact_type": {"type": "string", "minLength": 1}
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_gpu_hour_reduction",
        "minimum_positive_recall",
        "maximum_selector_negative_selection",
        "minimum_selector_choice_divergence_environment_count",
        "minimum_confirm_receipts"
      ],
      "properties": {
        "minimum_gpu_hour_reduction": {"type": "number", "minimum": 0},
        "minimum_positive_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_selector_negative_selection": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_selector_choice_divergence_environment_count": {"type": "integer", "minimum": 1},
        "minimum_confirm_receipts": {"type": "integer", "minimum": 1}
      }
    },
    "next_work": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
