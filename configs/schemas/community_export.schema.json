{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "state", "export_id", "source_root_count", "scanned_file_count", "candidate_document_count", "record_count", "record_digests", "artifact_type_counts", "ignored_document_count", "ignored_reason_counts", "graph_digest", "quality_audit_id", "source_execution", "claim_boundary"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-community-semantic-export"]},
    "state": {"enum": ["ready"]},
    "export_id": {"type": "string", "pattern": "^verdiwm-community-export-[0-9a-f]{24}$"},
    "source_root_count": {"type": "integer", "minimum": 1},
    "scanned_file_count": {"type": "integer", "minimum": 0},
    "candidate_document_count": {"type": "integer", "minimum": 1},
    "record_count": {"type": "integer", "minimum": 1},
    "record_digests": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "artifact_type_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "ignored_document_count": {"type": "integer", "minimum": 0},
    "ignored_reason_counts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "graph_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "quality_audit_id": {"type": "string", "minLength": 1},
    "source_execution": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["artifact_type", "batch_id", "execution_sha256", "plan_sha256", "state", "model_ids"],
      "properties": {
        "artifact_type": {"enum": ["verdiwm-model-batch-execution"]},
        "batch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
        "execution_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "state": {"enum": ["blocked", "partial", "queued", "completed", "failed"]},
        "model_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 12}
  }
}
