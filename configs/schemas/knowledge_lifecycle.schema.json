{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "lifecycle_id", "action", "subject", "replacement", "reason", "authority_ref", "evidence_refs"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-knowledge-lifecycle"]},
    "lifecycle_id": {"type": "string", "pattern": "^knowledge-lifecycle-[0-9a-f]{24}$"},
    "action": {"enum": ["revocation", "deprecation", "supersession"]},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "replacement": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "reason": {"type": "string", "minLength": 1},
    "authority_ref": {"type": "string", "pattern": "^(cas://|urn:|sha256:)"},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(cas://|urn:|sha256:)"}}
  }
}
