{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "verification_state",
    "verdict_authority",
    "decision",
    "evidence_stage",
    "contract_id",
    "contract_digest",
    "contract_ref",
    "policy_id",
    "policy_digest",
    "policy_ref",
    "verifier_implementation_sha256",
    "verifier_ref",
    "candidate",
    "screen",
    "confirm",
    "evidence_refs",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-acwm-materialized-frozen-verdict"]},
    "verification_state": {"enum": ["verified"]},
    "verdict_authority": {"enum": [true]},
    "decision": {"enum": ["confirmed_positive", "rejected_at_screen", "rejected_at_confirm", "operational_failure"]},
    "evidence_stage": {"enum": ["screen", "confirm"]},
    "contract_id": {"type": "string", "minLength": 1},
    "contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_ref": {"type": "string", "pattern": "^cas://sha256/[0-9a-f]{64}$"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "policy_ref": {"type": "string", "pattern": "^cas://sha256/[0-9a-f]{64}$"},
    "verifier_implementation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verifier_ref": {"type": "string", "pattern": "^cas://sha256/[0-9a-f]{64}$"},
    "candidate": {"type": "object"},
    "screen": {"type": "object"},
    "confirm": {"type": ["object", "null"]},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^cas://sha256/[0-9a-f]{64}$"}
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
