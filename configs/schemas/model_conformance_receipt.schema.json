{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "state",
    "verdict",
    "optimization_launch_allowed",
    "repo_root",
    "sidecar_root",
    "onboarding_report_sha256",
    "source_revision",
    "source_tree_revision",
    "asset_bindings",
    "runtime_python",
    "evaluator_contract_sha256",
    "checks",
    "side_effects",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"type": "string", "enum": ["wmloop-model-conformance-receipt"]},
    "state": {"type": "string", "enum": ["settled"]},
    "verdict": {"type": "string", "enum": ["PASS", "BLOCKED"]},
    "optimization_launch_allowed": {"type": "boolean"},
    "repo_root": {"type": "string", "minLength": 1},
    "sidecar_root": {"type": "string", "minLength": 1},
    "onboarding_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_revision": {"type": "object"},
    "source_tree_revision": {"type": "object"},
    "asset_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameter", "kind", "resolved_path", "onboarding_fingerprint", "observed_fingerprint", "state"],
        "properties": {
          "parameter": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["checkpoint", "dataset_or_metadata", "model_dependency"]},
          "resolved_path": {"type": "string", "minLength": 1},
          "onboarding_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "observed_fingerprint": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "state": {"type": "string", "enum": ["bound", "missing", "drifted"]}
        }
      }
    },
    "runtime_python": {"type": ["string", "null"]},
    "evaluator_contract_sha256": {"type": ["string", "null"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status", "detail"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["pass", "fail"]},
          "detail": {"type": "string"},
          "exit_code": {"type": ["integer", "null"]},
          "timed_out": {"type": "boolean"},
          "duration_seconds": {"type": "number", "minimum": 0},
          "command": {"type": "array", "items": {"type": "string"}},
          "stdout_path": {"type": "string"},
          "stderr_path": {"type": "string"},
          "stdout_sha256": {"type": "string"},
          "stderr_sha256": {"type": "string"}
        }
      }
    },
    "side_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_modified", "dependency_install_started", "model_import_executed", "gpu_execution_started"],
      "properties": {
        "source_modified": {"type": "boolean"},
        "dependency_install_started": {"type": "boolean", "enum": [false]},
        "model_import_executed": {"type": "boolean"},
        "gpu_execution_started": {"type": "boolean", "enum": [false]}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 12}
  }
}
