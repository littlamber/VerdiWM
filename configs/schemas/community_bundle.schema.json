{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "state",
    "trust_state",
    "community_review_state",
    "publisher",
    "license_spdx_id",
    "graph_digest",
    "quality_audit_id",
    "record_count",
    "files",
    "claim_boundary",
    "bundle_id"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "artifact_type": {
      "enum": [
        "verdiwm-community-evidence-bundle"
      ]
    },
    "state": {
      "enum": [
        "ready"
      ]
    },
    "trust_state": {
      "enum": [
        "unverified",
        "locally_validated",
        "source_reproducible",
        "target_confirmed",
        "transfer_licensed",
        "community_reviewed",
        "revoked"
      ]
    },
    "community_review_state": {
      "enum": [
        "unreviewed",
        "reviewed",
        "withdrawn"
      ]
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisher_id",
        "signing_key_id"
      ],
      "properties": {
        "publisher_id": {
          "type": "string",
          "minLength": 3
        },
        "signing_key_id": {
          "type": "string",
          "pattern": "^key-[0-9a-f]{16}$"
        }
      }
    },
    "license_spdx_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "graph_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "quality_audit_id": {
      "type": "string",
      "minLength": 1
    },
    "record_count": {
      "type": "integer",
      "minimum": 1
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 12
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^verdiwm-bundle-[0-9a-f]{24}$"
    },
    "source_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "batch_id",
        "execution_sha256",
        "plan_sha256",
        "state",
        "model_ids"
      ],
      "properties": {
        "artifact_type": {
          "enum": [
            "verdiwm-model-batch-execution"
          ]
        },
        "batch_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
        },
        "execution_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state": {
          "enum": [
            "blocked",
            "partial",
            "queued",
            "running",
            "completed",
            "failed",
            "cancelled",
            "unavailable"
          ]
        },
        "model_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
