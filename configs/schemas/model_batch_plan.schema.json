{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "state", "batch_id", "request_sha256", "plan_sha256", "goal", "models", "budget", "claim_boundary"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-model-batch-plan"]},
    "state": {"enum": ["ready_for_dispatch", "blocked"]},
    "batch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "goal": {"type": "string", "minLength": 1},
    "models": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["model_id", "state", "model", "data", "goal", "budget", "target_metrics", "files", "file_sha256", "blockers", "model_digest"],
        "properties": {
          "model_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
          "state": {"enum": ["ready", "blocked"]},
          "model": {"type": "string", "minLength": 1},
          "data": {"type": "string", "minLength": 1},
          "goal": {"type": "string", "minLength": 1},
          "budget": {"type": "number", "exclusiveMinimum": 0},
          "target_metrics": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "adapter": {"type": ["string", "null"]},
          "assets": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
          "files": {
            "type": "object", "additionalProperties": false,
            "required": ["model", "data"],
            "properties": {
              "model": {"type": "string", "minLength": 1}, "data": {"type": "string", "minLength": 1},
              "adapter_profile": {"type": ["string", "null"]}, "runtime_python": {"type": ["string", "null"]},
              "evaluator_contract": {"type": ["string", "null"]}, "instance_config": {"type": ["string", "null"]},
              "dataset_freeze": {"type": ["string", "null"]}
            }
          },
          "file_sha256": {
            "type": "object", "additionalProperties": false,
            "required": ["model", "data"],
            "properties": {
              "model": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "data": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "adapter_profile": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "runtime_python": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "evaluator_contract": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "instance_config": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "dataset_freeze": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "source_revision": {"type": ["string", "null"]},
          "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "model_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["declared_gpu_hours", "model_count", "policy"],
      "properties": {
        "declared_gpu_hours": {"type": "number", "exclusiveMinimum": 0},
        "model_count": {"type": "integer", "minimum": 1},
        "policy": {"enum": ["sum_of_model_budgets"]}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 12}
  }
}
