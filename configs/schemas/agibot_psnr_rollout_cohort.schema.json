{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "claim_boundary", "evaluator_id",
    "evaluator_digest", "dataset_sha256", "support_sha256",
    "validation_sample_ids", "seed_cohort", "baseline", "candidate"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "verdiwm-agibot-psnr-rollout-cohort"},
    "claim_boundary": {"type": "string", "minLength": 24},
    "evaluator_id": {"const": "agibot-paired-rgb-psnr-v1"},
    "evaluator_digest": {"$ref": "#/$defs/hash"},
    "dataset_sha256": {"$ref": "#/$defs/hash"},
    "support_sha256": {"$ref": "#/$defs/hash"},
    "validation_sample_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "seed_cohort": {
      "type": "array", "minItems": 3, "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}
    },
    "baseline": {"$ref": "#/$defs/arm"},
    "candidate": {"$ref": "#/$defs/arm"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "settings": {"type": "object", "minProperties": 1},
    "sample": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_id", "prediction_frames", "prediction_sha256", "ground_truth_frames", "ground_truth_sha256"],
      "properties": {
        "sample_id": {"type": "string", "minLength": 1},
        "prediction_frames": {"type": "string", "minLength": 1},
        "prediction_sha256": {"$ref": "#/$defs/hash"},
        "ground_truth_frames": {"type": "string", "minLength": 1},
        "ground_truth_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "seed_run": {
      "type": "object", "additionalProperties": false,
      "required": ["seed", "samples"],
      "properties": {
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sample"}}
      }
    },
    "arm": {
      "type": "object", "additionalProperties": false,
      "required": [
        "checkpoint_sha256", "evaluator_digest", "dataset_sha256", "support_sha256",
        "validation_sample_ids", "seed_cohort", "rollout_settings", "decode_settings", "rollouts"
      ],
      "properties": {
        "checkpoint_sha256": {"$ref": "#/$defs/hash"},
        "evaluator_digest": {"$ref": "#/$defs/hash"},
        "dataset_sha256": {"$ref": "#/$defs/hash"},
        "support_sha256": {"$ref": "#/$defs/hash"},
        "validation_sample_ids": {"$ref": "#/properties/validation_sample_ids"},
        "seed_cohort": {"$ref": "#/properties/seed_cohort"},
        "rollout_settings": {"$ref": "#/$defs/settings"},
        "decode_settings": {"$ref": "#/$defs/settings"},
        "rollouts": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/seed_run"}}
      }
    }
  }
}
