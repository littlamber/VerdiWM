{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "state",
    "probe_id",
    "model_family",
    "runtime_capability",
    "failure_signatures",
    "metrics",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["verdiwm-diagnostic-probe-result"]},
    "state": {"enum": ["ready", "invalid"]},
    "probe_id": {"type": "string", "minLength": 1},
    "model_family": {"type": "string", "minLength": 1},
    "runtime_capability": {"type": "string", "minLength": 1},
    "failure_signatures": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"minLength": 1},
      "additionalProperties": {
        "type": "number",
        "minimum": -1.7976931348623157e308,
        "maximum": 1.7976931348623157e308
      }
    },
    "primitive": {"type": "string", "minLength": 1},
    "paired_observations": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"type": "object"},
      "description": "Each item is additionally validated by the shared diagnostic_paired_observation contract."
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "layout"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "layout": {"enum": ["vertical", "horizontal"]}
      }
    },
    "error": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "ready"}}},
      "then": {"properties": {"failure_signatures": {"minItems": 1}}},
      "else": {
        "required": ["error"],
        "properties": {"failure_signatures": {"maxItems": 0}}
      }
    }
  ]
}
