{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "report_id", "report_digest", "state", "metric_id", "metric_contract_digest", "evaluator_binding", "thresholds", "measurements", "gates", "evidence_refs", "verdict_authority"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "artifact_type": {"enum": ["wmloop-metric-adequacy-report"]},
    "report_id": {"type": "string", "pattern": "^metric-adequacy-[0-9a-f]{24}$"},
    "report_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["adequate", "inadequate"]},
    "metric_id": {"type": "string", "minLength": 1},
    "metric_contract_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluator_binding": {"type": "string", "pattern": "^(cas://|urn:|sha256:)"},
    "thresholds": {"type": "object", "additionalProperties": false, "required": ["minimum_discrimination_lower_bound", "maximum_reference_cv", "minimum_anti_goodhart_coverage", "minimum_incremental_information_lower_bound"], "properties": {"minimum_discrimination_lower_bound": {"type": "number"}, "maximum_reference_cv": {"type": "number", "minimum": 0}, "minimum_anti_goodhart_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "minimum_incremental_information_lower_bound": {"type": "number"}}},
    "measurements": {"type": "object", "additionalProperties": false, "required": ["reference_mean", "reference_cv", "regression_separation_lower_bound", "anti_goodhart_coverage", "incremental_information_lower_bound"], "properties": {"reference_mean": {"type": "number"}, "reference_cv": {"type": "number", "minimum": 0}, "regression_separation_lower_bound": {"type": "number"}, "anti_goodhart_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "incremental_information_lower_bound": {"type": "number"}}},
    "gates": {"type": "object", "additionalProperties": false, "required": ["discriminative_power", "seed_stability", "anti_goodhart_coverage", "incremental_information", "protected_metric_non_regression", "fresh_heldout_evidence"], "properties": {"discriminative_power": {"type": "boolean"}, "seed_stability": {"type": "boolean"}, "anti_goodhart_coverage": {"type": "boolean"}, "incremental_information": {"type": "boolean"}, "protected_metric_non_regression": {"type": "boolean"}, "fresh_heldout_evidence": {"type": "boolean"}}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^(cas://|urn:|sha256:)"}},
    "verdict_authority": {"enum": [false]}
  }
}
