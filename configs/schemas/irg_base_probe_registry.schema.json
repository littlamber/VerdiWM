{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "library_version",
    "outcome_probe_registry_ref",
    "admitted_path_registry_ref",
    "base_probes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "verdiwm-irg-base-probe-registry"},
    "library_version": {"type": "string", "minLength": 1},
    "outcome_probe_registry_ref": {"type": "string", "minLength": 1},
    "admitted_path_registry_ref": {"type": "string", "minLength": 1},
    "base_probes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "semantic_variable",
          "diagnoses",
          "dose_unit",
          "inference_only",
          "reversible",
          "acwm_v1_status",
          "acwm_v1_admitted_paths"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "display_name": {"type": "string", "minLength": 1},
          "semantic_variable": {"type": "string", "minLength": 1},
          "diagnoses": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "dose_unit": {"type": "string", "minLength": 1},
          "inference_only": {"const": true},
          "reversible": {"const": true},
          "acwm_v1_status": {
            "enum": [
              "measured_and_admitted",
              "runtime_hook_only",
              "not_materialized_for_atlas"
            ]
          },
          "acwm_v1_admitted_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
