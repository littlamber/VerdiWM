{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "campaign_id",
    "objective",
    "selection_reason",
    "falsification_criterion",
    "total_budget_gpu_hours",
    "max_selected_candidates",
    "scoring",
    "candidates"
  ],
  "properties": {
    "schema_version": {"enum": [1]},
    "artifact_type": {"enum": ["verdiwm-auto-experiment-candidate-batch"]},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "objective": {"type": "string", "minLength": 12},
    "selection_reason": {"type": "string", "minLength": 12},
    "falsification_criterion": {"type": "string", "minLength": 12},
    "total_budget_gpu_hours": {"type": "number", "exclusiveMinimum": 0},
    "max_selected_candidates": {"type": "integer", "minimum": 1},
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_gain_weight", "uncertainty_weight", "information_gain_weight", "novelty_weight", "cost_weight"],
      "properties": {
        "expected_gain_weight": {"type": "number", "minimum": 0},
        "uncertainty_weight": {"type": "number", "minimum": 0},
        "information_gain_weight": {"type": "number", "minimum": 0},
        "novelty_weight": {"type": "number", "minimum": 0},
        "cost_weight": {"type": "number", "minimum": 0},
        "retrieval_weight": {"type": "number", "minimum": 0}
      }
    },
    "onboarding_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_path", "receipt_sha256", "onboarding_report_sha256"],
      "properties": {
        "receipt_path": {"type": "string", "minLength": 1},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "onboarding_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "diagnostic_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_path", "manifest_sha256", "failure_signatures", "retrieval_state"],
      "properties": {
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "failure_signatures": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "retrieval_state": {"enum": ["matched", "cold_start", "literature_only"]}
      }
    },
    "literature_sources": {
      "type": "array",
      "items": {"type": "object"}
    },
    "literature_method_sources": {
      "type": "array",
      "items": {"type": "object"}
    },
    "method_candidate_compilation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "manifest_sha256",
        "compiled_candidate_ids",
        "capability_gap_count",
        "historical_constraint_count"
      ],
      "properties": {
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "compiled_candidate_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "capability_gap_count": {"type": "integer", "minimum": 0},
        "historical_constraint_count": {"type": "integer", "minimum": 0}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "experiment_kind",
          "hypothesis",
          "selection_reason",
          "falsification_criterion",
          "expected_gain",
          "uncertainty",
          "information_gain",
          "novelty",
          "stages"
        ],
        "properties": {
          "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "experiment_kind": {"enum": ["model_training", "evaluation_only", "data_only", "diagnostic"]},
          "hypothesis": {"type": "string", "minLength": 12},
          "selection_reason": {"type": "string", "minLength": 12},
          "falsification_criterion": {"type": "string", "minLength": 12},
          "expected_gain": {"type": "number", "minimum": 0, "maximum": 1},
          "uncertainty": {"type": "number", "minimum": 0, "maximum": 1},
          "information_gain": {"type": "number", "minimum": 0, "maximum": 1},
          "novelty": {"type": "number", "minimum": 0, "maximum": 1},
          "retrieval_prior": {"type": "number", "minimum": 0, "maximum": 1},
          "retrieval_matches": {"type": "array", "items": {"type": "object"}},
          "literature_arxiv_ids": {"type": "array", "items": {"type": "string"}},
          "retrieval_keys": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "failure_signatures": {"type": "array", "items": {"type": "string"}},
              "primitive": {"type": "string"},
              "stage": {"type": "string"}
            }
          },
          "routing_admission": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "reason", "matched_failure_signatures"],
            "properties": {
              "state": {"enum": ["eligible", "blocked"]},
              "reason": {"type": "string", "minLength": 1},
              "matched_failure_signatures": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "promotion_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["required_stage", "required_quality_metrics"],
            "properties": {
              "required_stage": {"enum": ["confirm"]},
              "required_quality_metrics": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          },
          "training_binding": {
            "type": "object", "additionalProperties": false,
            "required": ["train_manifest", "validation_manifest", "mode", "steps", "record_limit", "sampler", "seed_count", "scale_plan_sha256", "runner_contract"],
            "properties": {
              "train_manifest": {"type": "string", "minLength": 1},
              "validation_manifest": {"type": "string", "minLength": 1},
              "mode": {"enum": ["probe", "long"]},
              "steps": {"type": "integer", "minimum": 1},
              "record_limit": {"type": "integer", "minimum": 0},
              "sampler": {"enum": ["sequential", "episode_balanced"]},
              "seed_count": {"type": "integer", "minimum": 1},
              "validation_panel_size": {"type": "integer", "minimum": 1},
              "scale_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "runner_contract": {"type": "string", "minLength": 1}
            }
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stage",
                "command",
                "working_directory",
                "allowed_gpu_indices",
                "estimated_gpu_hours",
                "timeout_seconds",
                "gpu_wait_seconds",
                "sample_interval_seconds",
                "result_path",
                "artifacts",
                "metric_gates",
                "environment",
                "cleanup_policy"
              ],
              "properties": {
                "stage": {"enum": ["screen", "gate", "confirm"]},
                "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "working_directory": {"type": "string", "minLength": 1},
                "allowed_gpu_indices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
                "estimated_gpu_hours": {"type": "number", "exclusiveMinimum": 0},
                "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
                "gpu_wait_seconds": {"type": "number", "minimum": 0},
                "sample_interval_seconds": {"type": "number", "exclusiveMinimum": 0},
                "result_path": {"type": "string", "minLength": 1},
                "artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
                "metric_gates": {"type": "array", "minItems": 1, "items": {"type": "object"}},
                "environment": {"type": "object"},
                "cleanup_policy": {"enum": ["retain", "archive_then_delete"]}
              }
            }
          }
        },
        "allOf": [
          {
            "if": {"properties": {"experiment_kind": {"const": "model_training"}}, "required": ["experiment_kind"]},
            "then": {"required": ["training_binding"]}
          },
          {
            "if": {"properties": {"experiment_kind": {"enum": ["evaluation_only", "data_only", "diagnostic"]}}, "required": ["experiment_kind"]},
            "then": {"not": {"required": ["training_binding"]}}
          }
        ]
      }
    }
  }
}
