{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "proposal_id",
    "version",
    "objective",
    "hypothesis",
    "falsification_criterion",
    "selection_reason",
    "evidence_refs",
    "workflow",
    "dataset",
    "scale_profile",
    "evaluation",
    "budget",
    "expected_artifacts",
    "authority"
  ],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "artifact_type": {"enum": ["verdiwm-research-proposal"]},
    "proposal_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "version": {"type": "string", "pattern": "^v[0-9]+$"},
    "objective": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "falsification_criterion": {"type": "string", "minLength": 1},
    "selection_reason": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_id", "workflow_version", "skills"],
      "properties": {
        "workflow_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
        "workflow_version": {"type": "string", "pattern": "^v[0-9]+$"},
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"}
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train_manifest", "validation_manifest", "dataset_freeze", "split_policy", "mutation_policy"],
      "properties": {
        "train_manifest": {"type": "string", "minLength": 1},
        "validation_manifest": {"type": "string", "minLength": 1},
        "dataset_freeze": {"type": "string", "minLength": 1},
        "split_policy": {"type": "string", "minLength": 1},
        "mutation_policy": {"enum": ["frozen"]}
      }
    },
    "scale_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "batch_size", "gradient_accumulation", "world_size", "sequence_length", "requested_seed_count", "training_recipe_id"],
      "properties": {
        "stage": {"enum": ["smoke", "screen", "pilot", "confirm"]},
        "batch_size": {"type": "integer", "minimum": 1},
        "gradient_accumulation": {"type": "integer", "minimum": 1},
        "world_size": {"type": "integer", "minimum": 1},
        "sequence_length": {"type": ["integer", "null"], "minimum": 1},
        "requested_seed_count": {"type": "integer", "minimum": 1},
        "training_recipe_id": {"type": ["string", "null"]}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "horizons", "seeds", "heldout_protocol"],
      "properties": {
        "metrics": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "horizons": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "seeds": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
        "heldout_protocol": {"type": "string", "minLength": 1}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_gpu_hours", "max_trials"],
      "properties": {
        "max_gpu_hours": {"type": "number", "exclusiveMinimum": 0},
        "max_trials": {"type": "integer", "minimum": 1}
      }
    },
    "expected_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_policy", "data_split_policy", "promotion_policy"],
      "properties": {
        "evaluator_policy": {"enum": ["frozen"]},
        "data_split_policy": {"enum": ["frozen"]},
        "promotion_policy": {"enum": ["verifier_only"]}
      }
    }
  }
}
